From 734bdae3db6f28439eaea1a13c28bd3445690af8 Mon Sep 17 00:00:00 2001
From: Rob Currie <rob@example.invalid>
Date: Sat, 21 Nov 2026 04:34:51 +0000
Subject: [PATCH 2/3] tests: every branch of a TRef read out of a tree, and of
 Show's members

The four lines the coverage gate found unexercised: the object filed in the
file's ProcessID record it names, a clone reading a split collection from the
objects its source tree was given (and not when a member is a whole TRef), and
Show's two member shapes - one name per object, and an object left as a
pointer.
---
 tests/test_pyroot_clones_split.py | 43 +++++++++++++++++++++++++++++++
 tests/test_pyroot_trees_print.py  | 33 ++++++++++++++++++++++++
 tests/test_pyroot_trees_refs.py   | 18 +++++++++++++
 3 files changed, 94 insertions(+)

diff --git a/tests/test_pyroot_clones_split.py b/tests/test_pyroot_clones_split.py
index 4d07ac7a..6ce9999c 100644
--- a/tests/test_pyroot_clones_split.py
+++ b/tests/test_pyroot_clones_split.py
@@ -498,3 +498,46 @@ def test_a_class_nobody_declared_is_made_by_the_part_of_the_kit_that_knows_it():
     assert _member("TNamed", {"fName": "n", "fTitle": ""}) is None
     assert _member("Nowhere", {"fName": "n"}) is None
     assert _member("TNamed", ["n"]) is None  # not a row of members at all
+
+
+def test_a_clone_reads_a_collection_from_the_objects_its_source_tree_was_given(tmp_path):
+    """``SetBranchAddress`` gives the source tree the objects to read into, and it is those a
+    ``TRef`` made from them numbered, so a clone writes them and not the copies the entry was
+    read as (roottest/root/io/tree/create-r)."""
+    from types import SimpleNamespace
+
+    from xrdroot.pycint.runtime import Cell
+
+    path = str(tmp_path / "clones.root")
+    _written(path)
+    source = ROOT.TFile(path)
+    upstream = source.Get("T")
+    slot = upstream.CloneTree(0)._store.slots["N"]
+    live = ROOT.TClonesArray("TNamed")
+    for at, name in enumerate(("A", "B", "C")):
+        live.ConstructedAt(at).SetName(name)
+    upstream.SetBranchAddress("N", Cell(live))
+    assert slot._live() is live
+    assert [row[2] for row in slot.read()] == ["A", "B", "C"]
+    upstream._addresses["N"] = SimpleNamespace(get=lambda: None)
+    assert slot._live() is None
+    upstream._addresses["N"] = SimpleNamespace(get=lambda: 0)
+    assert slot._live() is None
+    upstream._addresses["N"] = SimpleNamespace(value=live)  # an address with no ``get``
+    assert slot._live() is live
+    source.Close()
+
+
+def test_a_collection_holding_a_whole_object_per_row_is_copied_from_the_values_read(tmp_path):
+    """A ``TRef`` member is streamed by its own class, so its row is the object itself and
+    not a member of the objects the tree was given."""
+    from types import SimpleNamespace
+
+    path = str(tmp_path / "clones.root")
+    _written(path)
+    source = ROOT.TFile(path)
+    slot = source.Get("T").CloneTree(0)._store.slots["N"]
+    reference = CloneMember("tref_test_pid", 1, "fRef", objects.OBJECT_TYPE, "fRef", 0, 1, "TRef")
+    slot._kind = SimpleNamespace(members=[reference])
+    assert slot._live() is None
+    source.Close()
diff --git a/tests/test_pyroot_trees_print.py b/tests/test_pyroot_trees_print.py
index 32a702c2..3afa01e8 100644
--- a/tests/test_pyroot_trees_print.py
+++ b/tests/test_pyroot_trees_print.py
@@ -277,3 +277,36 @@ def test_a_member_of_whole_objects_is_printed_as_the_class_or_the_pointer_it_is(
     leaf = SimpleNamespace(name="r1.fRef", text=False, vector=False, classname="")
     lines = show_lines(0, [(leaf, [{"TObject": {"fUniqueID": 1}}])])
     assert lines[-1] == " r1.fRef         = ->"
+
+
+def test_a_text_leaf_whose_values_are_not_text_is_printed_as_it_stands():
+    from xrdroot.pyroot.trees.printing import show_lines
+
+    leaf = SimpleNamespace(name="code", text=True, vector=False, classname="")
+    lines = show_lines(0, [(leaf, np.array([65, 66], dtype=np.int8))])
+    assert lines[-1] == " code            = [65 66]"
+
+
+def test_a_member_that_holds_no_value_at_all_is_left_out_of_what_show_prints():
+    from xrdroot.pyroot.trees.printing import show_lines
+
+    leaf = SimpleNamespace(name="r1", text=False, vector=False, classname="")
+    lines = show_lines(0, [(leaf, {"fRef": None, "fName": np.array([])})])
+    assert lines == ["======> EVENT:0"]
+
+
+def test_a_member_that_is_an_object_is_printed_as_the_pointer_show_does_not_expand():
+    from xrdroot.pyroot.trees.printing import show_lines
+
+    leaf = SimpleNamespace(name="r1", text=False, vector=False, classname="")
+    one_object = [object()]  # a TRef, as the reader hands one back: not a number, not text
+    lines = show_lines(0, [(leaf, {"fRef": one_object})])
+    assert lines == ["======> EVENT:0", " fRef            = ->"]
+
+
+def test_a_member_of_one_name_per_object_is_printed_as_the_names_it_holds():
+    from xrdroot.pyroot.trees.printing import show_lines
+
+    leaf = SimpleNamespace(name="N", text=False, vector=False, classname="")
+    lines = show_lines(0, [(leaf, {"fName": np.array(["N_0_0", "N_0_1"])})])
+    assert lines == ["======> EVENT:0", " fName           = N_0_0, N_0_1"]
diff --git a/tests/test_pyroot_trees_refs.py b/tests/test_pyroot_trees_refs.py
index 154d1dfc..7ed5f947 100644
--- a/tests/test_pyroot_trees_refs.py
+++ b/tests/test_pyroot_trees_refs.py
@@ -332,3 +332,21 @@ def test_the_reference_of_a_member_read_back_names_the_process_of_the_file_it_ca
     assert isinstance(made.GetPID(), TProcessID)
     assert made.GetObject() is None  # the object itself was never read into this session
     read.Close()
+
+
+def test_an_object_a_reference_may_point_at_is_filed_in_the_file_process_that_numbered_it():
+    """A file that carries the ``ProcessID`` record its references name: the object is filed
+    there under the number in the low bits of its identifier, which is where the reference
+    read beside it looks (roottest/root/io/tree/test-r)."""
+    from xrdroot.pyroot.core.references import IS_REFERENCED, filed_object
+
+    out = ROOT.TFile("withpid.root", "RECREATE")
+    out.WriteTObject(ROOT.TRef(ROOT.TNamed("N", "N")), "ref")
+    out.Close()
+    read = ROOT.TFile("withpid.root")
+    held = ROOT.TNamed("N_0_0", "")
+    held.SetBit(IS_REFERENCED)
+    held.SetUniqueID(1)
+    filed_object(held, read)
+    assert read.ReadProcessID(0).GetObjectWithID(1) is held
+    read.Close()
