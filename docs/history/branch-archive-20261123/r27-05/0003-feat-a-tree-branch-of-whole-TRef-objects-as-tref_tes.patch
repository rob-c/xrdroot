+def test_a_branch_of_whole_references_is_one_record_an_entry_and_the_file_describes_TRef():
+    """``TTree::Branch("Refs", "TRef", &ref, 4000, 0)`` asks for the reference unsplit, which
+    ROOT writes as ``TRef::Streamer`` does - a version, the number, the bits and the index of
+    the file's process record - with ``TRef`` described by its ``TObject`` base alone, as the
+    6.40 oracle's ``tref_test.root`` holds it (roottest/root/io/tree/tref-write)."""
+    import xrdroot
+    from xrdroot.pyroot.trees.objects import WholeReference
+
+    spec = WholeReference(basket_size=4000)
+    branch = spec.build("Refs", 4000)
+    assert (branch.info.classname, branch.info.version) == ("TRef", 1)
+    assert [leaf.name for leaf in branch.leaves()] == ["Refs"]
+    assert [(one.name, one.version, one.checksum) for one in spec.declared()] == [
+        ("TRef", 1, 0x91757901)
+    ]  # fmt: skip
+
+    out = ROOT.TFile("refs.root", "RECREATE")
+    tree = ROOT.TTree("tree", "references")
+    ref = Cell(ROOT.TRef())
+    tree.Branch("Refs", "TRef", ref, 4000, 0)
+    named = ROOT.TNamed("N", "referred to")
+    ref.value.Set(named)
+    tree.Fill()
+    ref.value.Set(None)
+    tree.Fill()
+    tree.Write()
+    out.Close()
+    with xrdroot.open_root("refs.root") as held:
+        assert held.keys() == ["ProcessID0", "tree"]
+        written = held["tree"]
+        assert list(written.branches) == ["Refs"]
+        records = list(written.branches["Refs"].array(0, 2))
+        numbers = [record["TObject"]["fUniqueID"] for record in records]
+        assert numbers == [1, 0]  # the object it refers to, then the reference cleared
+    # The session's processes are not what ``fresh`` puts back, and a process numbers its
+    # objects from one: a test after this one would otherwise start where this one stopped.
+    from xrdroot.pyroot.core.references import TProcessID
+
+    TProcessID._pids.clear()
+    TProcessID._current = None
+    TProcessID.SetObjectCount(0)
