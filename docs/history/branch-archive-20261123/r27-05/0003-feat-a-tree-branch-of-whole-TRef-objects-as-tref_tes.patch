+@dataclass(frozen=True)
+class WholeReference(Spec):
+    """A ``TRef`` branch written whole: one record an entry, and the file's own description.
+
+    ``INFOS`` holds no ``TRef`` - ROOT streams the class by hand - so its layout is the one
+    :data:`~xrdroot.wclasses.TREF` works out from ROOT's declaration, its ``TObject`` base
+    alone, and the branch's checksum and version are that layout's, as ROOT's file says.
+    """
+
+    def build(self, name: str, basket_size: int) -> Branch:
+        column = StreamedColumn(name, self._size(basket_size))
+        info = ElementInfo("TRef", "", "", TREF.checksum, TREF.version, WHOLE, MEMBER,
+                           NOT_A_MEMBER)  # fmt: skip
+        leaf = ElementLeaf(name, name, 0, WHOLE, NOT_A_MEMBER)
+        return Branch(name, name, self.split, column, [leaf], info)
+
+    def declared(self) -> tuple[Any, ...]:
+        """The description of ``TRef`` the file carries, which ROOT reads the branch back by.
+
+        The class is not among the file's *used* ones, which the writer looks up among ROOT's
+        own descriptions - ``INFOS`` holds no ``TRef``, which streams itself - so it travels
+        described instead, as a macro's class does.
+        """
+        return (Described("TRef", TREF.version, TREF.checksum, TREF.elements()),)
+
+
+class Reference(_Whole):
+    """A branch of whole ``TRef`` objects, one ``TRef::Streamer`` record an entry.
+
+    ``TTree::Branch("Refs", "TRef", &ref, 4000, 0)`` asks ROOT for the reference unsplit -
+    "do not split the TRef's branch", as ``roottest``'s ``tref_test.C`` says - and ROOT
+    writes what the class streams itself: a version, the number of the object it refers
+    to, its bits and the index of the file's process record that numbered it. No layout of
+    members exists to split, so the branch is one column of those records, written by the
+    same ``tref_record`` a split ``TClonesArray`` writes a ``TRef`` member with.
+    """
+
+    def spec(self, obj: Any, split: int, bufsize: int | None) -> Spec:
+        return WholeReference(basket_size=bufsize)
+
+    def entry(self, obj: Any) -> bytes:
+        _named_processes([obj])
+        return tref_record(obj)
+
+
