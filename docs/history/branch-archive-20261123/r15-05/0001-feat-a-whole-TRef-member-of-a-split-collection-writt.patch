 INTEGERS = ("int", "Int_t", "unsigned int", "UInt_t")
@@ -198,6 +206,26 @@ def _tref() -> Layout:
 TREF: Layout = _tref()
 
 
+def whole_object(name: str) -> Layout:
+    """The description a member that is a whole object of its own is written by.
+
+    Such a member is laid out by its own class, not by the class that declares
+    it, so the writer needs that class's description: ``TRef`` is written by:
+    :data:`TREF`, the description no file of ROOT's needs to carry, and any
+    other class by the donors' description of it.
+    """
+    if name == "TRef":
+        return TREF
+    found = harvested(name)
+    if found is None:
+        raise UnsupportedFeatureError(
+            f"a member that is a whole {name} of its own is written here only for a class "
+            f"this writer carries a description of, and it carries none of {name}; write "
+            f"the member as a number instead, or leave it out of the class"
+        )
+    return found
+
+
 def declared(cls: Any) -> Layout:
     """A class a macro declared, from what its translation says of its members."""
     name, bases, fields = cls._cxx_layout_
