+def test_roottest_lotsref_writes_a_whole_tref_as_its_version_and_tobject():
+    """ROOT 6.40 writes a split collection's whole ``TRef`` member into the entry as ten
+    bytes: the class's version, then ``TObject``'s identifier and bits - no byte count,
+    which a member held by value does not need since its class says how long it is. The
+    bytes here are the oracle's own for ``roottest``'s ``io/references/lotsRef``."""
+    reference = {"fUniqueID": 1, "fBits": 0}
+
+    def get(name: str) -> Any:
+        return reference[name]
+
+    assert held_object(TREF, get) == bytes.fromhex("00010000000100000000")
+
+
+def test_a_whole_objects_bits_are_written_without_the_ones_streaming_sets():
+    """``TObject::Streamer`` leaves ``kIsOnHeap`` and ``kNotDeleted`` out, so a reference to
+    an object on the heap is written with neither of them."""
+    bits = 0x03000000 | 0x0400
+    assert held_object(TREF, lambda name: 7 if name == "fUniqueID" else bits) == bytes.fromhex(
+        "00010000000700000400"
+    )
+
+
+def _described_elsewhere() -> Layout:
+    """A class of one number, as a file might describe one."""
+    number = Member("fX", 5, "float", "", 4)
+    return Layout("Elsewhere", 3, 0, (number,))
+
+
+def test_a_whole_object_of_a_number_and_a_string_is_written_too():
+    """A member's class need not be ``TRef``: any class the writer carries a description
+    of is written its way, each number packed as its streamer type packs it."""
+    written = held_object(_described_elsewhere(), lambda name: 1.5)
+    assert written == bytes.fromhex("0003") + pack_member(5, "", np.array([1.5]))
+
+
+def test_a_whole_objects_member_that_is_no_number_is_refused_by_name():
+    """Only numbers are packed into such a record here, so a member of anything else says
+    which member it is rather than writing bytes the file could not be read back by."""
+    text = Member("fS", 65, "TString", "", 4)
+    laid_out = Layout("Elsewhere", 1, 0, (text,))
+    with pytest.raises(UnsupportedFeatureError, match=r"Elsewhere holds fS, a BasicType"):
+        held_object(laid_out, lambda name: "")
+
+
+def test_a_whole_object_is_written_by_the_description_of_its_own_class():
+    """The class a whole-object member is written by is the member's, not its owner's, and
+    ``TRef`` is described here alone - no file of ROOT's carries its description."""
+    assert whole_object("TRef") is TREF
+    assert whole_object("TAttLine").name == "TAttLine"
+    with pytest.raises(UnsupportedFeatureError, match=r"carries none of TNamed"):
+        whole_object("TNamed")
+
+
+def test_a_split_collections_whole_object_column_streams_the_objects_of_a_row():
+    """The column of a whole-object member is given the objects themselves, one row per
+    entry, and streams each by its class: a ``TRef``'s identifier is what it holds."""
+    column = _column("C1._o", CloneMember("A", 0, "_o", 61, "", 0, 0, "TRef"), 32000)
+    assert isinstance(column, WholeObjectRows)
+    references = [{"fUniqueID": 3, "fBits": 0}, {"fUniqueID": 9, "fBits": 0}]
+    assert column.pack(references) == bytes.fromhex("00010000000300000000") + bytes.fromhex(
+        "00010000000900000000"
+    )
+    raw, sizes = column.pack_many([references[:1], references[1:]])
+    assert raw == column.pack(references) and list(sizes) == [10, 10]
+
+
+def test_a_whole_objects_member_is_read_off_it_by_the_object_it_is():
+    """A ``TRef`` keeps its identifier and bits where ``TObject`` does and names them no
+    attribute, so they come through its accessors; an object of a macro's class keeps them
+    in its table of members, and anything else - a ``RooFit`` object's row - by name."""
+    reference = ROOT.TRef(None)
+    reference.SetUniqueID(11)
+    read = wbranch._member_reader(reference)
+    assert (read("fUniqueID"), read("fBits")) == (11, reference._bitword())
+    table = type("Row", (), {"members": {"fUniqueID": 4, "fBits": 0x0400}})()
+    assert wbranch._member_reader(table)("fUniqueID") == 4
+    plain = type("Plain", (), {"GetUniqueID": lambda self: 5, "fName": "here"})()
+    assert wbranch._member_reader(plain)("fName") == "here"
