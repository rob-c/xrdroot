+def held_object(layout: Layout, get: Callable[[str], Any]) -> bytes:
+    """One whole object, written into a tree entry as a member of another class is.
+
+    A member held by value says how long it is through its class, so this is
+    no record of its own and carries no byte count in front: the entry holds
+    the class's version and then its elements - for a ``TRef``, ``TObject``'s
+    identifier and bits, ten bytes in all, which is what ROOT 6.40 writes for
+    ``roottest``'s ``io/references/lotsRef``. ``get`` reads one member off the
+    object by ROOT's name for it.
+    """
+    buf = WBuffer()
+    buf.raw(struct.pack(">H", layout.version))
+    for kind, name, title, stype, *_rest in layout.elements():
+        if kind == "TStreamerBase" and name == "TObject":
+            # The version in front is the one ``TObject::Streamer`` writes as well, so the
+            # base adds no second one: only the identifier and the bits it keeps.
+            bits = int(get("fBits")) & ~TRANSIENT_BITS
+            buf.raw(struct.pack(">II", int(get("fUniqueID")), bits))
+        elif kind == "TStreamerBasicType" and stype in BASIC:
+            value = np.asarray([get(name)], dtype=np.float64)
+            buf.raw(pack_member(stype, title, value))
+        else:
+            raise UnsupportedFeatureError(
+                f"{layout.name} holds {name}, a {kind[9:]} that is no number, so a member "
+                f"that is a whole {layout.name} of its own cannot be written into a tree "
+                f"entry here; write the member as a number instead, or leave it out"
+            )
+    return bytes(buf.data)
+
+
 @dataclass(frozen=True)
 class SplitClones(Spec):
     """A ``TClonesArray`` of objects of class ``element`` split as ``TTree::Branch`` splits one:
@@ -821,5 +856,48 @@ def _column(name: str, member: CloneMember, size: int) -> Any:
     if member.stype == TSTRING:
         return StringRows(name, size)
     if member.stype == OBJECT:
-        return StreamedColumn(name, size)
+        return WholeObjectRows(name, whole_object(member.typename), size)
     return MemberRows(name, member.stype, member.title, size)
+
+
+class WholeObjectRows(StreamedColumn):
+    """One whole object of every object in a split collection - a ``TRef``: a row of them
+    per entry, each written as ROOT writes a member held by value - its class's version and
+    then its elements, with no byte count in front, which only a record of its own carries.
+
+    The objects arrive as they are rather than as bytes, so this is where a row becomes one
+    entry of the branch: :func:`held_object` lays each object out.
+    """
+
+    __slots__ = ("layout",)
+
+    def __init__(self, name: str, layout: Layout, basket_size: int) -> None:
+        super().__init__(name, basket_size)
+        self.layout = layout
+
+    def pack(self, value: Any) -> bytes:
+        return b"".join(held_object(self.layout, _member_reader(obj)) for obj in value)
+
+
+def _member_reader(obj: Any) -> Callable[[str], Any]:
+    """How a member of one whole object is read off it, by ROOT's name for it: the
+    identifier and the bits through ``TObject``'s own accessors, since a ``TRef`` keeps
+    them where ``TObject`` does and names them no attribute; anything else through the
+    object's table of members or, for an object of a macro's class, its attributes."""
+    if isinstance(obj, dict):
+        return obj.__getitem__
+    members = getattr(obj, "members", None)
+    return members.__getitem__ if members is not None else _attribute_reader(obj)
+
+
+#: ``TObject``'s two members, and the accessor each keeps them behind.
+ACCESSORS = {"fUniqueID": "GetUniqueID", "fBits": "_bitword"}
+
+
+def _attribute_reader(obj: Any) -> Callable[[str], Any]:
+    """``TObject``'s two members as its accessors give them, and the rest by name."""
+
+    def read(name: str) -> Any:
+        return getattr(obj, ACCESSORS[name])() if name in ACCESSORS else getattr(obj, name)
+
+    return read
