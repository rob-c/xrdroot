+def test_a_copied_objects_identifier_names_the_record_the_new_file_makes_for_it():
+    """A clone copies an object a reference may point at with the byte its source file wrote
+    above the number - the index of *that* file's ``ProcessID`` record plus one - and the new
+    file numbers its own records as it writes them: the process that file recorded first may be
+    the second one here, and then every identifier naming it goes out with the second's index.
+    """
+    source = {"ProcessID0": {"TNamed": {"fTitle": "the-source-uuid"}}}
+    out = ROOT.TFile("renumbered.root", "RECREATE")
+    out.WriteProcessID("another-uuid")  # the record this file makes first
+    member = CloneMember("tref_test_pid", 0, "fRef", 61, "a reference")
+    described = {"TObject": {"fUniqueID": 3, "fBits": 0}, "fPID": 0}
+    unique = CloneMember("TObject", 0, "fUniqueID", 15, "")
+    entry = [(described, 0x01000003), (described, 0)]  # one numbered, one no process numbered
+    rows = objects._written_processes([member, unique], [entry], source, False)
+    assert rows == [[({**described, "fPID": 1}, 0x02000003), ({**described, "fPID": 1}, 0)]]
+    out.Close()
+
+
+def test_a_live_objects_identifier_names_the_record_the_new_file_makes_for_it():
+    """An object still in memory carries the index of its process in the *session*, which is
+    where ``TProcessID::AssignID`` put it; the file being written knows that process by the
+    index of a record of its own, so the byte goes out as that index plus one."""
+    out = ROOT.TFile("live.root", "RECREATE")
+    out.WriteProcessID("another-uuid")  # the record this file makes first
+    named = ROOT.TNamed("N", "N")
+    ROOT.TRef(named)  # numbers it in the session's own process
+    unique = CloneMember("TObject", 0, "fUniqueID", 15, "")
+    number = named.GetUniqueID()
+    rows = objects._written_processes([unique], [[(number,)], [(0x05000009,)]], None, True)
+    assert rows[0][0][0] == 0x02000000 | (number & 0xFFFFFF)
+    assert rows[1][0][0] == 0x05000009  # a session index no process of this one has
+    out.Close()
+
+
+def test_no_file_being_written_leaves_every_index_as_it_was_read():
+    """A tree written into memory has no ``ProcessID`` records to name, so a row keeps the
+    index it was read with - which is the only one a reader of it could make sense of."""
+    unique = CloneMember("TObject", 0, "fUniqueID", 15, "")
