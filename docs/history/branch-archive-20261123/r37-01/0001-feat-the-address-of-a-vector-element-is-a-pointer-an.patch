 )
 from .operators import conversion
 from .symbols import Symbol
@@ -359,13 +361,43 @@ class CallEmitter(ExprEmitter):
         if ends is not None:
             return ends
         if isinstance(it, Binary) and it.op == "+":
-            base, _ = self._iterator(it.left, node, end)
-            return base, self.value(it.right)
+            base, start = self._iterator(it.left, node, end)
+            moved = self.value(it.right)
+            return base, moved if start == "0" else f"{start} + {moved}"
+        addressed = self._element_pointer(it)
+        if addressed is not None:
+            return addressed
         found = self.typeof(it)
         if found is not None and (found.is_array or found.is_pointer):
             return self.value(it), "0"
         raise self.refuse("an iterator this translator cannot follow back to its container", node)
 
+    def _element_pointer(self, it: Expr) -> tuple[str, str] | None:
+        """``&v[i]`` and ``&v.front()`` as the range end they are: the vector, and the offset.
+
+        C++ hands an algorithm the pointer into the vector's own buffer, and the
+        algorithm writes back through it, so the range names the vector and an
+        index rather than a copy of the elements from there on.
+        """
+        if not isinstance(it, Unary) or it.op != "&":
+            return None
+        target = it.operand
+        if isinstance(target, Index):
+            return self.value(target.obj), self.value(target.index)
+        if isinstance(target, Call) and isinstance(target.func, Member):
+            return self._element_call_end(target)
+        return None
+
+    def _element_call_end(self, call: Call) -> tuple[str, str] | None:
+        """``&v.front()`` as ``(v, 0)`` and ``&v.at(i)`` as ``(v, i)``."""
+        assert isinstance(call.func, Member)
+        first = self.value(call.func.obj)
+        if call.func.name == "front" and not call.args:
+            return first, "0"
+        if call.func.name == "at" and len(call.args) == 1:
+            return first, self.value(call.args[0])
+        return None
+
     def _container_end(self, it: Expr) -> tuple[str, str] | None:
         """``v.begin()`` as ``(v, 0)`` and ``v.end()`` as ``(v, None)``: where a range starts."""
         if not isinstance(it, Call) or it.args or not isinstance(it.func, Member):
diff --git a/src/xrdroot/pycxx/emit_expr.py b/src/xrdroot/pycxx/emit_expr.py
index 1602e7a0..d34a6377 100644
--- a/src/xrdroot/pycxx/emit_expr.py
+++ b/src/xrdroot/pycxx/emit_expr.py
@@ -482,6 +482,7 @@ class ExprEmitter(NameEmitter):
         if isinstance(operand, Unary) and operand.op in ("++", "--") and not operand.postfix:
             borrowed = self.borrowed_reference(operand)
         borrowed = borrowed if borrowed is not None else self.reader_reference(operand)
+        borrowed = borrowed if borrowed is not None else self._element_call_address(operand)
         if borrowed is None and _is_unaddressable_update(operand):
             # An update whose destination has no reference at all has no address to take.
             raise Refusal(
@@ -520,6 +521,22 @@ class ExprEmitter(NameEmitter):
             return f"{array}[{index}:]", P.POSTFIX
         return f"ItemRef({self.value(operand.obj)}, {index})", P.POSTFIX
 
+    def _element_call_address(self, operand: Expr) -> str | None:
+        """``&v.front()``: element 0 of the vector, which is what ``&v[0]`` is.
+
+        ``v.front()`` on its own is that element's value; the address of it is a
+        pointer into the vector, and a call given it - ``TGraph(n, &x.front(), ...)``
+        - must see every element rather than the one value.
+        """
+        if not isinstance(operand, Call) or not isinstance(operand.func, Member):
+            return None
+        func = operand.func
+        if func.name == "front" and not operand.args:
+            return f"ItemRef({self.value(func.obj)}, 0)"
+        if func.name == "at" and len(operand.args) == 1:
+            return f"ItemRef({self.value(func.obj)}, {self.value(operand.args[0])})"
+        return None
+
     def reference(self, target: Expr) -> str:
         """What reads and writes ``target`` as ``.value``: a cell, an ItemRef or an AttrRef."""
         borrowed = self.reader_reference(target)
diff --git a/tests/cppstd/test_cppstd_pure_values.py b/tests/cppstd/test_cppstd_pure_values.py
index 28af3a27..4f815d58 100644
--- a/tests/cppstd/test_cppstd_pure_values.py
+++ b/tests/cppstd/test_cppstd_pure_values.py
@@ -44,6 +44,17 @@ def test_cell_item_and_attribute_references_write_the_storage_they_capture() ->
         number[1] = 4
 
 
+def test_a_taken_element_address_is_a_pointer_over_the_containers_own_elements() -> None:
+    values = [1.5, 2.5, 3.5]
+    pointer = cells.ItemRef(values, 1)
+    assert len(pointer) == 2 and list(pointer) == [2.5, 3.5]
+    assert pointer[1:2] == [3.5] and pointer[:] == [2.5, 3.5]
+    pointer[0:1] = [7.0]
+    assert values == [1.5, 7.0, 3.5]
+    pointer[1:] = [8.0]
+    assert values == [1.5, 7.0, 8.0]
+
+
 def test_generic_assignment_updates_held_containers_and_keeps_the_return_contract() -> None:
     target, source = [1], [2, 3]
     assert references.assign_into(target, source) is source and target == [2, 3]
