+    def _generate(self, func: Name, node: Call) -> Out | None:
+        """``std::generate(first, last, f)``: each element of the range set from ``f()``."""
+        if len(node.args) != 3:
+            raise self.refuse(f"std::{func.last} without a range and a function", node)
+        helper = "for_each_range" if func.last == "for_each" else "generate_range"
+        return self._ranged(helper, node)
+
+    def _ranged(self, helper: str, node: Call) -> Out | None:
+        """``helper(v, start, stop, f)``: the range an algorithm works through and its function."""
+        container, start, stop = self.iterator_range(node.args[0], node.args[1], node)
+        return f"{helper}({container}, {start}, {stop}, {self.value(node.args[2])})", P.POSTFIX
+
+    def _equal(self, func: Name, node: Call) -> Out | None:
+        """``std::equal(first, last, other)``: whether the range holds what ``other`` does."""
+        if len(node.args) not in (3, 4):
+            raise self.refuse("std::equal over ranges of two lengths", node)
+        if len(node.args) == 4:
+            raise self.refuse("std::equal with a comparison of its own", node)
+        container, start, stop = self.iterator_range(node.args[0], node.args[1], node)
+        other, other_start = self._iterator(node.args[2], node, "begin")
+        return f"equal_range({container}, {start}, {stop}, {other}, {other_start})", P.POSTFIX
+
     def iterator_range(self, first: Expr, last: Expr, node: Expr) -> tuple[str, str, str]:
         """``v.begin(), v.end()`` or ``a, a + n``: the container, start and stop they mean."""
         container, start = self._iterator(first, node, "begin")
