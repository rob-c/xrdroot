 from .valuecopy import value_copy as value_copy
 
 __all__ = [
@@ -35,6 +36,9 @@ __all__ = [
     "iterate",
     "sort_range",
     "reverse_range",
+    "generate_range",
+    "for_each_range",
+    "equal_range",
     "CppException",
