@@ -278,6 +282,36 @@ def reverse_range(container: Any, start: int, stop: Any) -> None:
     container[start:end] = list(container[start:end])[::-1]
 
 
+def generate_range(container: Any, start: int, stop: Any, make: Callable[[], Any]) -> None:
+    """``std::generate(first, last, f)``: each element of the range given ``f()``, in place."""
+    end = len(container) if stop is None else int(stop)
+    for index in range(int(start), end):
+        container[index] = make()
+
+
+def for_each_range(container: Any, start: int, stop: Any, apply: Callable[[Any], Any]) -> None:
+    """``std::for_each(first, last, f)``: ``f`` given each element's address, in order.
+
+    C++ hands ``f`` the element itself - a reference, which is a pointer an
+    ``operator()(T *)`` takes - so an ``ItemRef`` is what it is called with.
+    """
+    end = len(container) if stop is None else int(stop)
+    for index in range(int(start), end):
+        apply(ItemRef(container, index))
+
+
+def equal_range(container: Any, start: int, stop: Any, other: Any, other_start: int = 0) -> bool:
+    """``std::equal(first, last, other)``: the range's values and the ones from ``other``.
+
+    The second sequence only has to be long enough, as C++ requires, so only as
+    many of its elements as the first range holds are compared.
+    """
+    end = len(container) if stop is None else int(stop)
+    wanted = list(container[int(start):end])
+    first = int(other_start)
+    return wanted == list(other[first:first + len(wanted)])
+
+
 class CppException(Exception):
     """A C++ ``throw`` of anything: the value thrown, and ``what()`` as ``std::exception`` has."""
 
