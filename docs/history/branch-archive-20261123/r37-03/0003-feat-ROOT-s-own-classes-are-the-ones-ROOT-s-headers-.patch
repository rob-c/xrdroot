From 2464376384d66413c1554ffd5f90a12e6aeceb25 Mon Sep 17 00:00:00 2001
From: Rob Currie <rob@example.invalid>
Date: Sat, 21 Nov 2026 14:09:47 +0000
Subject: [PATCH 3/3] feat: ROOT's own classes are the ones ROOT's headers
 declare

Whether a file's class needs a dictionary is not a question a name's spelling
answers: a geometry file describes ROOT's TGeoAtt, TGeoVoxelFinder and
TGeoParallelWorld, which the importer reads past and ROOT opens in silence,
while roottest's missingClass describes a program's own TEmcl.  reflection
now asks the names ROOT 6.40's headers declare - 1632 ClassDef classes of the
root 6.40.04 conda-forge build's top-level headers, in
pyroot/core/rootdict.py, with how they were harvested - and, besides, what
the kit implements and what it streams, so a class a macro declared, a
generated dictionary's or a template's instance of one needs none either.
The name-shape heuristic that stood in for that table is gone.
---
 src/xrdroot/pyroot/core/reflection.py |  18 +-
 src/xrdroot/pyroot/core/rootdict.py   | 290 ++++++++++++++++++++++++++
 tests/test_pyroot_reflection.py       |  22 ++
 3 files changed, 324 insertions(+), 6 deletions(-)
 create mode 100644 src/xrdroot/pyroot/core/rootdict.py

diff --git a/src/xrdroot/pyroot/core/reflection.py b/src/xrdroot/pyroot/core/reflection.py
index 104631a9..373545ce 100644
--- a/src/xrdroot/pyroot/core/reflection.py
+++ b/src/xrdroot/pyroot/core/reflection.py
@@ -482,23 +482,29 @@ def _modelled(name: str) -> bool:
     for, so that opening a file which describes it says nothing?
 
     A name's spelling is no help: a user's class is called ``TEmcl`` or ``TCedarEvent`` as
-    readily as ROOT's own is called ``TBasket``, and ROOT warns of the program's four
+    readily as ROOT's own is called ``TRegexp``, and ROOT warns of the program's four
     emulated classes in ``roottest/root/io/tree``'s ``missingClass`` while staying silent
     about the ``TTree`` beside them. What tells them apart is knowledge of the class, not of
-    its name, and what the kit knows of ROOT's classes is what it implements - as a Python
-    class of the namespace's, ``TCanvas`` and ``TUUID`` too, which derive from no ``TObject``
-    here - and what it streams: the layouts of :data:`xrdroot.winfo.INFOS`, and the readers
-    of :mod:`xrdroot.objects` and :mod:`xrdroot.known` for the classes the kit writes itself.
-    A name none of those knows is emulated from the file with ROOT's warning.
+    its name: the names of ROOT's own, harvested from ROOT's headers, are
+    :data:`ROOT_CLASSES` - a template's instance asked about by its head's name, since
+    ``TParameter<double>`` is a layout of ``TParameter``'s - and what the kit knows of them
+    is what it implements, as a Python class of the namespace's (``TCanvas`` and ``TUUID``
+    too, which derive from no ``TObject`` here), and what it streams: the layouts of
+    :data:`xrdroot.winfo.INFOS`, and the readers of :mod:`xrdroot.objects` and
+    :mod:`xrdroot.known` for the classes the kit writes itself. A name none of those knows
+    is emulated from the file with ROOT's warning.
     """
     from ...known import KNOWN
     from ...objects import CLASSES
     from ...sparse import SPARSE
+    from .rootdict import ROOT_CLASSES
 
     if name in INFOS or name in GENERATED:
         return True
     if name in CLASSES or name in KNOWN or name in SPARSE:
         return True
+    if name.split("<", 1)[0] in ROOT_CLASSES:
+        return True
     return _implemented(name)
 
 
