diff --git a/tests/test_pyroot_reflection.py b/tests/test_pyroot_reflection.py
index 7ec0da18..cf1dc3d5 100644
--- a/tests/test_pyroot_reflection.py
+++ b/tests/test_pyroot_reflection.py
@@ -1105,3 +1105,25 @@ def test_a_files_classes_are_warned_of_in_the_order_root_wrote_them(capfd):
     reflection.note_file_infos(described)
     printed = capfd.readouterr().err
     assert printed.index("class TEmcl") < printed.index("class TPhysObj")
+
+
+def test_a_class_of_roots_own_needs_no_dictionary_whatever_the_kit_models(capfd):
+    """ROOT's libraries were built with the dictionaries of their own classes, so a file
+    describing ``TGeoAtt`` - which the geometry importer reads past - ``TRegexp`` or a
+    ``TParameter<double>``, whose dictionary is the template's, opens in silence; the names
+    come from ROOT's headers, since not every one of them has a layout or a class here."""
+    described = [
+        ("TGeoAtt", (0x21, 1, ())),
+        ("TRegexp", (0x22, 1, ())),
+        ("TParameter<double>", (0x23, 1, ())),
+    ]
+    reflection.note_file_infos(described)
+    assert capfd.readouterr().err == ""
+
+
+def test_a_class_a_generated_dictionary_describes_needs_no_dictionary(capfd):
+    """``gInterpreter->GenerateDictionary`` gives a class a dictionary there and then, so a
+    file read afterwards describes a class ROOT knows and says nothing about it."""
+    ROOT.TClassTable.Add("TEmcl", 1)
+    reflection.note_file_infos([("TEmcl", (0x31, 1, ()))])
+    assert capfd.readouterr().err == ""
