From 22f15cb533911f3f0073fd3ad2ec11abc7eb0409 Mon Sep 17 00:00:00 2001
From: Rob Currie <rob@example.invalid>
Date: Sat, 21 Nov 2026 13:50:52 +0000
Subject: [PATCH 2/3] fix: a file's classes are warned of in the order ROOT
 wrote them

TClass::Init's warnings follow the order a file's streamer information records
its classes in, and ROOT registers a class as it first streams an object of
it - a base's after the derived class's - where the writer here lays a base
down first.  So roottest/root/io/tree's missingClass warned of TPhysObj before
TEmcl and differed from missingClass.ref, which names TEmcl first.  A file's
classes are now put in ROOT's order before they are warned of, worked out from
the layouts' TStreamerBase elements; the layouts themselves are still noted in
the file's order, which is the order GetStreamerInfos lists them in.
---
 src/xrdroot/pyroot/core/reflection.py | 52 ++++++++++++++++++++++++++-
 tests/test_pyroot_reflection.py       | 12 +++++++
 2 files changed, 63 insertions(+), 1 deletion(-)

diff --git a/src/xrdroot/pyroot/core/reflection.py b/src/xrdroot/pyroot/core/reflection.py
index c4ab4100..104631a9 100644
--- a/src/xrdroot/pyroot/core/reflection.py
+++ b/src/xrdroot/pyroot/core/reflection.py
@@ -226,9 +226,10 @@ def note_file_infos(infos: list[tuple[str, Layout]], source: Any = None) -> None
     :mod:`xrdroot.streamers` read them from.
     """
     origin = _origin(source)
-    for name, (checksum, version, elements) in infos:
+    for name in _as_root_lists_them(infos):
         if name not in FILE_INFOS and _undictionaried(name):
             message("Warning", "TClass::Init", "no dictionary for class %s is available", name)
+    for name, (checksum, version, elements) in infos:
         met = _met(name, (checksum, version, elements), origin)
         if met or _in_memory(name, checksum, version):
             continue
@@ -237,6 +238,55 @@ def note_file_infos(infos: list[tuple[str, Layout]], source: Any = None) -> None
         held.append((checksum, _free_version(name, version, taken), elements))
 
 
+def _as_root_lists_them(infos: list[tuple[str, Layout]]) -> list[str]:
+    """The classes a file describes, in the order ROOT warns of them: a class before the
+    classes its layout is built on.
+
+    ROOT registers a class's streamer information as it first streams an object of it, and a
+    base's after the derived class's - ``roottest/root/io/tree``'s ``write.C`` streams a
+    ``TEmcl``, whose base is ``TPhysObj``, so the file ROOT wrote lists ``TEmcl`` first and
+    ``missingClass.ref`` names it first. The writer here lays a base down before its derived
+    class, which is ROOT's order read backwards, so the order ROOT would have read is worked
+    out from the layouts: a class whose base the file lists before it is warned of first, and
+    the base with it.
+    """
+    bases = {}
+    for name, (_sum, _version, elements) in infos:
+        bases[name] = _bases_of(elements)
+    deferred: set[str] = set()
+    for found in bases.values():
+        deferred.update(found)
+    order: list[str] = []
+    warned: set[str] = set()
+    for name, _layout in infos:
+        if name not in deferred:
+            _warn_order(name, bases, order, warned)
+    for name, _layout in infos:
+        _warn_order(name, bases, order, warned)
+    return order
+
+
+def _bases_of(elements: tuple[Element, ...]) -> list[str]:
+    """The classes a layout is built on: the names of its ``TStreamerBase`` elements."""
+    found = []
+    for element in elements:
+        if element[0] == "TStreamerBase":
+            found.append(element[1])
+    return found
+
+
+def _warn_order(name: str, bases: dict[str, list[str]], order: list[str],
+                warned: set[str]) -> None:  # fmt: skip
+    """``name``, then the classes its layout is built on, each once - which is the order a
+    file ROOT wrote lists them in."""
+    if name in warned:
+        return
+    warned.add(name)
+    order.append(name)
+    for base in bases.get(name, ()):
+        _warn_order(base, bases, order, warned)
+
+
 def _origin(source: Any) -> str:
     """Which file the layouts came from, for the warning that names it."""
     if source is not None:
diff --git a/tests/test_pyroot_reflection.py b/tests/test_pyroot_reflection.py
index 7c6bf958..7ec0da18 100644
--- a/tests/test_pyroot_reflection.py
+++ b/tests/test_pyroot_reflection.py
@@ -1093,3 +1093,15 @@ def test_a_member_the_two_layouts_type_alike_names_no_new_type(capsys):
     assert "   i= 0, first           type=  3, offset=  0, len=1, method=0" in printed
     # A member the layout in memory does not have is the file's own, new type or no.
     assert "   i= 1, gone            type=  3, offset=  0, len=1, method=0" in printed
+
+
+def test_a_files_classes_are_warned_of_in_the_order_root_wrote_them(capfd):
+    """ROOT registers a class's streamer information as it first streams an object of it and a
+    base's after the derived class's, so ``roottest/root/io/tree``'s file lists ``TEmcl``
+    before its base ``TPhysObj`` and ``missingClass.ref`` names it first. The writer here lays
+    a base down first, so the warnings are put in ROOT's order before they are given."""
+    base = ("TStreamerBase", "TPhysObj", "", 0, 0, 0, 0, (0, 0, 0, 0, 0), "BASE", (0,))
+    described = [("TPhysObj", (0x1, 1, ())), ("TEmcl", (0x2, 1, (base,)))]
+    reflection.note_file_infos(described)
+    printed = capfd.readouterr().err
+    assert printed.index("class TEmcl") < printed.index("class TPhysObj")
