From a6dad150ed2810ea1fa3d36211bd81505ed23d3c Mon Sep 17 00:00:00 2001
From: Rob Currie <rob@example.invalid>
Date: Sat, 21 Nov 2026 13:43:57 +0000
Subject: [PATCH 1/3] feat: a user class named like ROOT's own still needs its
 dictionary

TClass::Init warns about a class a file describes for which nothing has a
dictionary.  What stood in for ROOT's own TClassTable here was the shape of
the name - T and an uppercase letter, Roo, ROOT:: - so roottest's
io/tree/missingClass, which reads a file describing a program's own TEmcl,
TPhysObj, TNonEmcl and TNonPhysObj, opened in silence where ROOT names all
four.  ROOT knows a class by its dictionary and not by its spelling: what
tells its own classes apart is what the kit implements (the namespace's
classes, TStyle and TUUID included, which derive from no TObject here) and
what it streams (winfo.INFOS's layouts, and the readers of objects, known
and sparse).  A name none of those knows is emulated from the file with
ROOT's warning.
---
 src/xrdroot/pyroot/core/reflection.py | 44 +++++++++++++++++++++++----
 tests/test_pyroot_reflection.py       | 30 ++++++++++++++++++
 2 files changed, 68 insertions(+), 6 deletions(-)

diff --git a/src/xrdroot/pyroot/core/reflection.py b/src/xrdroot/pyroot/core/reflection.py
index fd65e279..c4ab4100 100644
--- a/src/xrdroot/pyroot/core/reflection.py
+++ b/src/xrdroot/pyroot/core/reflection.py
@@ -417,20 +417,52 @@ def _is_constant(name: str, value: Any) -> bool:
     return bool(_CONSTANT.match(name)) and isinstance(value, int) and not isinstance(value, bool)
 
 
-#: What the names of ROOT's own classes look like: each has a dictionary in ROOT.
-ROOT_NAMES = re.compile(r"^(T[A-Z]|Roo|ROOT::|TMVA::|RooStats::|HistFactory::)")
-
-
 def _undictionaried(name: str) -> bool:
     """Has nothing here a dictionary of the class ``name`` - neither the program nor ROOT -
     which ROOT warns of when a file it opens describes one?"""
-    if ROOT_NAMES.match(name) or _template(name) or _synthetic_pair(name):
+    if _template(name) or _synthetic_pair(name):
         return False
-    if _pair_base(name) or _instantiable(name):
+    if _pair_base(name) or _instantiable(name) or _modelled(name):
         return False
     return TClass(name)._class() is None
 
 
+def _modelled(name: str) -> bool:
+    """Is ``name`` a class of ROOT's own, one of those ROOT's libraries carry a dictionary
+    for, so that opening a file which describes it says nothing?
+
+    A name's spelling is no help: a user's class is called ``TEmcl`` or ``TCedarEvent`` as
+    readily as ROOT's own is called ``TBasket``, and ROOT warns of the program's four
+    emulated classes in ``roottest/root/io/tree``'s ``missingClass`` while staying silent
+    about the ``TTree`` beside them. What tells them apart is knowledge of the class, not of
+    its name, and what the kit knows of ROOT's classes is what it implements - as a Python
+    class of the namespace's, ``TCanvas`` and ``TUUID`` too, which derive from no ``TObject``
+    here - and what it streams: the layouts of :data:`xrdroot.winfo.INFOS`, and the readers
+    of :mod:`xrdroot.objects` and :mod:`xrdroot.known` for the classes the kit writes itself.
+    A name none of those knows is emulated from the file with ROOT's warning.
+    """
+    from ...known import KNOWN
+    from ...objects import CLASSES
+    from ...sparse import SPARSE
+
+    if name in INFOS or name in GENERATED:
+        return True
+    if name in CLASSES or name in KNOWN or name in SPARSE:
+        return True
+    return _implemented(name)
+
+
+def _implemented(name: str) -> bool:
+    """Does the namespace hold a class called ``name``, whether or not it derives from
+    ``TObject`` - which is how ``TEventList``, ``TUUID``, ``TStyle`` and ``TColor`` are known
+    to be ROOT's own, whose files ROOT describes without a warning."""
+    for module in list(sys.modules.values()):
+        if getattr(module, "__name__", "").startswith("xrdroot.pyroot"):
+            if isinstance(getattr(module, name, None), type):
+                return True
+    return False
+
+
 def _pair_base(name: str) -> bool:
     """Is ``name`` the ``__pair_base<A,B>`` a standard library's ``pair`` derives from?
 
diff --git a/tests/test_pyroot_reflection.py b/tests/test_pyroot_reflection.py
index 7582483e..7c6bf958 100644
--- a/tests/test_pyroot_reflection.py
+++ b/tests/test_pyroot_reflection.py
@@ -634,6 +634,36 @@ def test_a_name_that_is_no_instance_of_anything_needs_its_dictionary(capfd):
     assert "no dictionary for class <odd> is available" in printed
 
 
+def test_a_user_class_named_like_roots_own_needs_its_dictionary(capfd):
+    """A name's spelling says nothing about whose class it is: ``roottest/root/io/tree``'s
+    ``missingClass`` reads a file describing ``TEmcl``, ``TPhysObj``, ``TNonEmcl`` and
+    ``TNonPhysObj``, a program's own classes all four, and ROOT warns of each beside the
+    ``TTree`` its file describes without a word."""
+    reflection.note_file_infos([("TEmcl", (0x7D5A2E11, 1, ()))])
+    assert (
+        "Warning in <TClass::Init>: no dictionary for class TEmcl is available"
+        in capfd.readouterr().err
+    )
+
+
+def test_a_root_class_the_kit_streams_needs_no_dictionary(capfd):
+    """ROOT's own classes have the dictionaries its libraries were built with, and the kit
+    knows them by what it streams: the layout ``TH1F`` is written with, ``TBasket``'s reader,
+    ``THnSparseD``'s branches and ``TRef``'s."""
+    described = [(name, (index, 1, ())) for index, name in enumerate(
+        ("TH1F", "TBasket", "THnSparseD", "TRef"))]
+    reflection.note_file_infos(described)
+    assert capfd.readouterr().err == ""
+
+
+def test_a_root_class_the_kit_implements_without_a_tobject_needs_no_dictionary(capfd):
+    """``TStyle``, ``TCanvas`` and ``TColor`` are ROOT's own classes and have their
+    dictionaries, though the namespace's implementations of them derive from no ``TObject``
+    - a file describing one opens as quietly as ROOT opens it."""
+    reflection.note_file_infos([("TStyle", (0x11, 1, ())), ("TColor", (0x12, 1, ()))])
+    assert capfd.readouterr().err == ""
+
+
 def test_files_layouts_are_numbered_as_met_while_no_class_is_in_memory(capfd):
     _evo("int", "one.root")
     _evo("float", "two.root")
