From d2dd40075c9a90a3d05e47cf4a9acc5f2851c8ae Mon Sep 17 00:00:00 2001
From: Rob Currie <rob@example.invalid>
Date: Mon, 23 Nov 2026 00:44:22 +0000
Subject: [PATCH] feat: an axis' bin labels are written, in the layout ROOT
 writes them

TAxis.SetBinLabel named a bin in a dict this kit kept to itself, so a histogram
of named bins lost its names in the file: ROOT streams them as
TAxis::fLabels, and the file said so - the element is in the axis' layout and
the writer wrote a null pointer for it.

Measured off ROOT 6.40's own file (tests/data/labels-6.40.root, three bins with
the first and third named): fLabels is a TList of the named bins only, each a
TObjString whose fUniqueID is its bin number and whose fString is the name, and
an axis nobody labelled streams no list at all. This kit writes exactly that,
reads it back exactly that (TAxis._labels answers from fLabels when a file
brought it), and the four tests pin both directions - including a byte-structure
comparison with ROOT's own file.

W0-180 is closed; the labels a projection keeps (round 68) now survive a file
too.
---
 src/xrdroot/pyroot/core/axes.py |  31 +++++++++++++++-
 tests/data/README.md            |   1 +
 tests/data/labels-6.40.root     | Bin 0 -> 3815 bytes
 tests/test_pyroot_axes.py       |  63 ++++++++++++++++++++++++++++++++
 4 files changed, 93 insertions(+), 2 deletions(-)
 create mode 100644 tests/data/labels-6.40.root

diff --git a/src/xrdroot/pyroot/core/axes.py b/src/xrdroot/pyroot/core/axes.py
index 6f7e695d..b48eff50 100644
--- a/src/xrdroot/pyroot/core/axes.py
+++ b/src/xrdroot/pyroot/core/axes.py
@@ -333,12 +333,39 @@ class TAxis(TNamed, TAttAxis):
     # -- labels and time ---------------------------------------------------------------------
 
     def _labels(self) -> dict[str, str]:
-        """The labels by bin, the bin numbers as text: the members are walked by name."""
-        labels: dict[str, str] = self._row.setdefault("_labels", {})
+        r"""The labels by bin, the bin numbers as text: ROOT's ``fLabels``, read back as such.
+
+        A file keeps a labelled axis' names in ``fLabels`` - the ``TObjString``\ s that have
+        one, each with its bin number as its ``fUniqueID`` - so an axis read from a file has
+        its labels where ROOT put them and an axis a program labels has them here.
+        """
+        row = self._row
+        if "_labels" not in row:
+            row["_labels"] = {
+                str(item.get("TObject", {}).get("fUniqueID", at + 1)): str(item.get("fString", ""))
+                for at, item in enumerate(row.get("fLabels") or ())
+            }
+        labels: dict[str, str] = row["_labels"]
         return labels
 
     def SetBinLabel(self, bin: int, label: Any) -> None:
+        """``SetBinLabel``: ``bin``'s name, kept in the axis' ``fLabels`` as ROOT keeps it."""
         self._labels()[str(int(bin))] = str(label)
+        self._store_labels()
+
+    def _store_labels(self) -> None:
+        """``fLabels`` written as ROOT writes it: the named bins, each a ``TObjString`` whose
+        ``fUniqueID`` is its bin number - the layout measured off ROOT 6.40's own file."""
+        from ...writer import Record
+
+        held = self._labels()
+        self._row["fLabels"] = [
+            Record(
+                "TObjString",
+                {"TObject": {"fUniqueID": int(bin), "fBits": 0}, "fString": str(label)},
+            )
+            for bin, label in sorted(held.items(), key=lambda pair: int(pair[0]))
+        ]
 
     def GetBinLabel(self, bin: int) -> str:
         return self._labels().get(str(int(bin)), "")
