+def test_alt_reads_a_two_dimensional_array_at_the_one_index_the_loop_is_at(tmp_path):
+    """The flat index counts every level of the loop, not only the last one.
+
+    ``a[2][2][2]`` loops over eight elements in three levels, so ROOT reads a
+    ``b[2][2]`` beside it at ``i0 * 4 + i1 * 2 + i2`` - the one number its
+    levels make together - and a ``w[nw][2]`` of six elements at the same
+    number. Reading ``b`` row by row instead would give the alternative two
+    items early and then read on past it, and stopping the count at the last
+    level would repeat the second row. ``m - Alt$(c, 0)`` is the case where the
+    loop is shorter than the branch: ``c`` is four wide and ``m`` three, and
+    ROOT still reads ``c`` at the loop's six indexes rather than in rows of
+    four. The numbers are ROOT's, from a file it wrote with these same titles.
+    """
+    path = tmp_path / "flat-nested.root"
