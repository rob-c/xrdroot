+    def subtree(self, depth: int, node: Array) -> tuple[Array, Array]:
+        """Where the values under each of ``node`` start, and how many there are.
+
+        ``node`` are nodes of dimension ``depth`` - an entry at 0, an element of
+        one below. Their values are one run of the bottom array, which is what an
+        expression reads a branch flat at: the node at the bottom is one value,
+        or none where a cursor out of range was sent past the last one.
+        """
+        if depth == self.dims:  # the values themselves
+            return node, (node < len(self.content)).astype(np.int64)
+        start, stop = node, node + 1
+        for level in range(depth, self.dims):
+            offsets = self.offsets[level]
+            start = offsets[start]
+            stop = offsets[stop]
+        return start, stop - start
+
 
