new file mode 100644
index 00000000..f2bbc01d
--- /dev/null
+++ b/src/xrdroot/pycint/runtime/spinning.py
@@ -0,0 +1,62 @@
+"""``std::atomic`` of a translation: reading one hands the interpreter to another thread.
+
+C++'s ``while (counter < kNThreads) {}`` is a busy wait, and on a machine with a
+core to spare that is all it costs. Here every C++ thread is a Python thread of
+one interpreter: the spinning one holds the GIL, and the thread whose work it is
+waiting for needs that GIL to do the work - CPython hands it over only at its
+switch interval. A test whose workers finish in a millisecond then takes seconds
+per barrier, and ``roottest/root/multicore/testSetAddressLoop`` - nine workers
+between two such spins, thirty-three times - outlasts the harness's 300 s.
+
+So the reads a loop condition makes, truthiness and the comparisons, give the
+interpreter up with ``time.sleep(0)``, as a C++ spin gives up its core. This is
+:class:`xrdroot.cppstd.threads.atomic` and nothing else; the translation's
+``from xrdroot.pycint.runtime import *`` binds it over the plain one.
+"""
+
+from __future__ import annotations
+
+import time
+from typing import Any
+
+from ...cppstd.threads import atomic as _atomic
+
+__all__ = ["atomic"]
+
+
+def _shared() -> None:
+    """Let whoever else wants the interpreter have it, before looking at the value again."""
+    time.sleep(0)
+
+
+class atomic(_atomic):
+    """``std::atomic<T>`` of a translation: a read of one shares the interpreter."""
+
+    def __bool__(self) -> bool:
+        """``operator bool()``: whether the value is true - what ``while (flag) {}`` asks."""
+        _shared()
+        return bool(self._value)
+
+    def load(self) -> Any:
+        _shared()
+        return super().load()
+
+    def __eq__(self, other: object) -> bool:
+        _shared()
+        return super().__eq__(other)
+
+    def __lt__(self, other: Any) -> bool:
+        _shared()
+        return super().__lt__(other)
+
+    def __gt__(self, other: Any) -> bool:
+        _shared()
+        return bool(self._value > other)
+
+    def __le__(self, other: Any) -> bool:
+        _shared()
+        return bool(self._value <= other)
+
+    def __ge__(self, other: Any) -> bool:
+        _shared()
+        return bool(self._value >= other)
diff --git a/tests/test_cint_runtime.py b/tests/test_cint_runtime.py
index d327c507..c5993012 100644
--- a/tests/test_cint_runtime.py
+++ b/tests/test_cint_runtime.py
@@ -3,6 +3,7 @@
 from __future__ import annotations
 
 import math
+import threading
 from pathlib import Path
 
 import numpy as np
@@ -326,3 +327,56 @@ def test_fscanf_scans_text_into_the_buffer_a_char_array_is_held_in(tmp_path: Pat
 def test_fscanf_of_a_null_file_says_to_check_the_pointer() -> None:
     with pytest.raises(TypeError, match="fscanf of a null FILE"):
         rt.fscanf(None, "%d", Cell(0))
+
+
+def test_the_runtimes_atomic_is_the_one_whose_reads_share_the_interpreter() -> None:
+    from xrdroot.cppstd.threads import atomic as plain
+    from xrdroot.pycint.runtime import spinning
+
+    assert rt.atomic is spinning.atomic
+    assert issubclass(rt.atomic, plain)
+    #: A translation binds it through ``from xrdroot.pycint.runtime import *``.
+    assert "atomic" in rt.__all__
+
+
+def test_an_atomic_read_answers_the_value_it_holds() -> None:
+    counted = rt.atomic(3)
+    assert bool(counted) is True
+    assert (counted.load(), counted == 3, counted < 4) == (3, True, True)
+    assert (counted > 2, counted <= 3, counted >= 3) == (True, True, True)
+    assert rt.atomic(0).__bool__() is False
+
+
+def test_every_read_of_an_atomic_gives_the_interpreter_up(monkeypatch: pytest.MonkeyPatch) -> None:
+    from xrdroot.pycint.runtime import spinning
+
+    shared: list[int] = []
+    monkeypatch.setattr(spinning, "_shared", lambda: shared.append(1))
+    counted = rt.atomic(3)
+    reads = [
+        bool(counted),
+        counted.load(),
+        counted == 3,
+        counted < 4,
+        counted > 2,
+        counted <= 3,
+        counted >= 3,
+    ]
+    assert reads == [True, 3, True, True, True, True, True]
+    assert len(shared) == 7
+
+
+def test_a_spin_ends_when_another_thread_stores_false() -> None:
+    flag = rt.atomic(True)
+    cleared = threading.Event()
+
+    def spin() -> None:
+        while flag:
+            pass
+        cleared.set()
+
+    spinning = threading.Thread(target=spin, daemon=True)
+    spinning.start()
+    flag.store(False)
+    spinning.join(30)
+    assert cleared.is_set(), "a spin on an atomic never saw the false another thread stored"
