 def test_a_root_file_name_is_refused_with_what_to_do_instead() -> None:
     manager = ROOT.TGeoManager("exported", "a root file")
     _built(manager)
-    with pytest.raises(UnsupportedFeatureError, match=r"not written.*\.gdml instead"):
