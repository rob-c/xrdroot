diff --git a/src/xrdroot/pyroot/geom/rootfile.py b/src/xrdroot/pyroot/geom/rootfile.py
index 8d7aa2d0..be0aafb6 100644
--- a/src/xrdroot/pyroot/geom/rootfile.py
+++ b/src/xrdroot/pyroot/geom/rootfile.py
@@ -25,6 +25,10 @@ from typing import Any
 import numpy as np
 
 from ...errors import UnsupportedFeatureError
+from ...streamers import read_layouts
+from ...wdeclared import Catalogue, Declaration
+from ...wdobjects import DeclaredObject, Instance
+from ...writer import create
 from ..core.files import TFile
 from .manager import TGeoManager
 from .materials import TGeoMaterial, TGeoMedium, TGeoMixture
@@ -44,7 +48,7 @@ from .shapes import (
 )
 from .volumes import TGeoVolume
 
-__all__ = ["from_file"]
+__all__ = ["from_file", "to_file"]
 
 #: The solid kinds xrdroot has ROOT's class for, and the members of ROOT's file that class is
 #: made from, in its constructor's order.
@@ -132,7 +136,49 @@ def from_file(filename: str) -> TGeoManager:
             f"geometry it holds is not there to be built; write the geometry as GDML and read "
             f"that instead"
         )
-    return _built(members)
+    return _recorded(_built(members), reading, key, read)
+
+
+def _recorded(manager: TGeoManager, reading: Any, key: Any, read: Any) -> TGeoManager:
+    """The manager, told what the file it was read from said, so ``Export`` can say it again.
+
+    What a ``TGeoManager`` is, is thirty-odd members ROOT streams for the class itself: its
+    materials, media, solids, matrices, volumes and the placements between them, each the
+    object the file described it as. Reading one rebuilds the tree xrdroot answers
+    questions with, but not those members; keeping them is what lets the geometry be
+    written back as the ROOT file it was read from, which is what ``TGeoManager::Export``
+    does with a geometry, and ``roottest/root/io/geo`` exports nothing else.
+    """
+    source = getattr(getattr(reading, "_reading", None), "_source", None)
+    manager._recorded = (str(key.GetName()), str(read.GetTitle()), read._xrd,
+                         read_layouts(source) if source is not None else {})
+    return manager
+
+
+def to_file(manager: Any, filename: str) -> int:
+    """``manager``, written as the ROOT file ``filename`` names - what ``Export`` writes.
+
+    The record is the one the geometry was read from: the manager's own members, written by
+    the layouts that file described its classes with, which the new file describes too, so
+    that it is read back by ROOT as the geometry that went in. A geometry made in memory has
+    no such record - nothing but the tree xrdroot models, which is not what ROOT's
+    ``TGeoManager`` streams - so writing one is refused by name rather than faked.
+    """
+    recorded = manager._recorded
+    if recorded is None:
+        raise UnsupportedFeatureError(
+            f"TGeoManager::Export writes a geometry read from a file back as the ROOT file it "
+            f"came from, and {manager.GetName()} was made in memory, so its TGeoManager "
+            f"record is not one xrdroot can write; export the geometry to {filename}.gdml "
+            f"instead"
+        )
+    name, title, members, layouts = recorded
+    catalogue = Catalogue({classname: Declaration(classname, version, False, (), ())
+                          for classname, ((_sum, version, _elements),) in layouts.items()})
+    catalogue.infos.update({classname: found[0] for classname, found in layouts.items()})
+    with create(filename, title=title) as writing:
+        writing.write(name, DeclaredObject(Instance("TGeoManager", members), catalogue, title))
+    return 1
 
 
 def _manager_key(reading: Any, filename: str) -> Any:
