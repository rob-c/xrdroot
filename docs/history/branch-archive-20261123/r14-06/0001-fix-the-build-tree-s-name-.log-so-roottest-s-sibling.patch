 tests/test_rootsuite_judging.py   | 22 ++++++++++++++++-
 tests/test_rootsuite_running.py   | 14 +++++++++++
 tools/rootsuite/judge.py          | 39 ++++++++++++++++++++++++-------
 tools/rootsuite/model.py          |  6 +++++
 tools/rootsuite/roottestmacros.py | 22 +++++++++++++----
 tools/rootsuite/runner.py         | 21 +++++++++++++++--
 7 files changed, 124 insertions(+), 17 deletions(-)

diff --git a/tests/test_rootsuite_discovery.py b/tests/test_rootsuite_discovery.py
index d4e40800..2f7ac3a0 100644
--- a/tests/test_rootsuite_discovery.py
+++ b/tests/test_rootsuite_discovery.py
@@ -130,6 +130,23 @@ def test_a_root_exe_command_is_a_root_runner_with_its_arguments(tree):
     assert test.depends == ("test-stressvector",)
 
 
+def test_a_roottest_names_the_log_the_driver_writes_its_output_to(tmp_path):
+    write(tmp_path, {
+        "roottest/CMakeLists.txt": "ROOTTEST_ADD_TESTDIRS()\n",
+        "roottest/root/CMakeLists.txt": "ROOTTEST_ADD_TESTDIRS()\n",
+        "roottest/root/io/CMakeLists.txt": (
+            "ROOTTEST_ADD_TEST(run MACRO run.C)\n"
+            "ROOTTEST_ADD_TEST(reference COMMAND sed -e s,a,b,g run.log STOREOUT)\n"
+            "ROOTTEST_ADD_TEST(check COMMAND sed -e s,a,b,g run.log "
+            "OUTREF ${CMAKE_CURRENT_BINARY_DIR}/reference.log)\n"),
+        "roottest/root/io/run.C": "",
+    })
+    found = by_id(tmp_path)
+    assert found["roottest/root/io/run"].outlog == "roottest/root/io/run.log"
+    assert found["roottest/root/io/reference"].outlog == "roottest/root/io/reference.log"
+    assert found["roottest/root/io/check"].outref == "<build>/roottest/root/io/reference.log"
+
+
 def test_a_roottest_macro_keeps_its_reference_preferring_the_64_bit_one(tree):
     test = by_id(tree)["roottest/root/io/write"]
     assert test.ctest == "roottest-root-io-write"
diff --git a/tests/test_rootsuite_judging.py b/tests/test_rootsuite_judging.py
index 36dfc1fa..b024438d 100644
--- a/tests/test_rootsuite_judging.py
+++ b/tests/test_rootsuite_judging.py
@@ -6,7 +6,7 @@ from pathlib import Path
 
 import pytest
 from tools.rootsuite import cases, refdiff
-from tools.rootsuite.judge import judge, refusal
+from tools.rootsuite.judge import judge, logged_output, refusal
 from tools.rootsuite.model import Test
 from tools.rootsuite.process import Result
 
@@ -154,6 +154,26 @@ def test_a_cling_style_error_saying_xrdroot_lacks_something_is_unsupported(root)
     assert status(roottest(), wrong, root) == "FAIL"
 
 
+def test_a_reference_the_run_wrote_in_the_build_tree_is_read_from_the_working_copy(root):
+    work = root / "work"
+    (work / "a").mkdir(parents=True)
+    (work / "a/reference.log").write_text("value = 1\n")
+    test = roottest(outref="<build>/a/reference.log")
+    passed = judge(test, result("value = 1\n"), root, root, None, work)
+    assert passed.status == "PASS"
+    differs = judge(test, result("value = 2\n"), root, root, None, work)
+    assert differs.status == "DIFF" and "+value = 2" in differs.diff
+
+
+def test_the_log_kept_for_a_test_is_its_output_as_the_driver_converted_it(root):
+    test = roottest(outcnvcmd=("sed", "-e", "/(int) 0/d"))
+    assert logged_output(test, result("kept\n(int) 0\n"), root, root) == "kept\n"
+
+
+def test_a_test_that_checks_no_output_leaves_an_empty_log_as_the_driver_does(root):
+    assert logged_output(roottest(check_out=False), result("printed\n"), root, root) == ""
+
+
 def test_an_assert_macros_reference_is_compared_with_nothing_as_the_driver_writes_it(root):
     (root / "a/empty.ref").write_text("")
     test = roottest(outref="a/empty.ref", check_out=False)
