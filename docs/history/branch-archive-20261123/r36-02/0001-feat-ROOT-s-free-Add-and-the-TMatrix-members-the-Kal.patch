 def test_a_subscripted_vector_carries_its_size_and_element_type():
@@ -330,3 +332,13 @@ def test_a_result_that_is_not_a_symmetric_matrix_is_refused_by_name():
         AssignSym.Evaluate(SMatrix["double", 2, 2](), SMatrix["double", 2, 2]())
     with pytest.raises(TypeError, match="takes a symmetric SMatrix"):
         AssignSym.Evaluate(SVector["double", 2](1, 2), SMatrix["double", 2, 2]())
+
+
+def test_the_svector_and_smatrix_free_functions_are_root_maths_own_names() -> None:
+    for name in ("SMatrix", "SVector", "AssignSym", "Cross", "Dot", "Mag", "Mag2", "MatRepStd",
+                 "MatRepSym", "Similarity", "SimilarityT", "SMatrixIdentity", "Square", "Times",
+                 "Transpose", "Unit"):  # fmt: skip
+        assert getattr(ROOT.Math, name) is getattr(ROOT, name), name
+    square = ROOT.SMatrix["double", 2, 2](1, 2, 3, 4)
+    assert ROOT.Math.Transpose(square)(0, 1) == 3.0
+    assert ROOT.Add is Add  # ROOT's TMatrix free function, by that name
