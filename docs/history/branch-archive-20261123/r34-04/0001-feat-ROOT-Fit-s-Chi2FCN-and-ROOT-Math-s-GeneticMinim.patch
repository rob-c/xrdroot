diff --git a/src/xrdroot/pyroot/core/mathtools.py b/src/xrdroot/pyroot/core/mathtools.py
index 676ae3e6..935895ea 100644
--- a/src/xrdroot/pyroot/core/mathtools.py
+++ b/src/xrdroot/pyroot/core/mathtools.py
@@ -418,6 +418,17 @@ def _minimised(fcn: Any, settings: list[ParameterSettings]) -> Any:
     return core._result(made, names, False, int(made.nfcn))
 
 
+class Chi2FCN(fitdata.Chi2Function):
+    """``ROOT::Fit::Chi2FCN<Function>``: the chi-square of a function over binned data.
+
+    The macro names it with the function type it is a chi-square of, which is the one type
+    of function a ``Fitter`` fits with, so the subscript keeps the class it is written on.
+    """
+
+    def __class_getitem__(cls, function: Any) -> type[Chi2FCN]:
+        return cls
+
+
 class _FitNamespace:
     """``ROOT.Fit``: the ``ROOT::Fit`` namespace."""
 
@@ -426,6 +437,7 @@ class _FitNamespace:
     ParameterSettings = ParameterSettings
     BinData = fitdata.BinData
     Chi2Function = fitdata.Chi2Function
