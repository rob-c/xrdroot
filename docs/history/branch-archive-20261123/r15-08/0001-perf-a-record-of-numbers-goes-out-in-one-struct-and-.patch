+class _Row:
+    """How a record whose members are every one of them a plain number is written: the names
+    to take off the object, in order, and the one ``struct`` that writes them all.
+
+    ``None`` for the members it holds means the record is not one of numbers and every element
+    keeps the writer its kind asks for. Worked out once per class, since what the members are
+    is nothing a record changes.
+    """
+
+    def __init__(self, pack: struct.Struct | None, names: tuple[str, ...]) -> None:
+        self.pack = pack
+        self.names = names
+
+    def numbers(self, writer: _Writer, members: Mapping[str, Any]) -> bool:
+        """``members`` written in one call, and whether they were: a number ``struct`` refuses -
+        one too wide for its member, a float where an integer is declared, a string where a
+        number is - is left to the writer each element's own kind gives, which wraps or
+        truncates it as ROOT on file holds it."""
+        if self.pack is None:
+            return False
+        take = members.get
+        try:
+            writer.buf.raw(self.pack.pack(*[take(name, 0) for name in self.names]))
+        except (struct.error, TypeError):
+            return False
+        return True
+
+
+@functools.lru_cache(maxsize=ROWS_KEPT)
+def _row_as(catalogue: Catalogue, classname: str) -> _Row:
+    """How the class ``classname``'s record is written, made the first time it is asked.
+
+    Kept by :func:`functools.lru_cache` and not in a dictionary of weak keys: a bulk
+    ``TClass::Streamer`` loop asks this once per record, and a weak lookup makes a reference
+    out of the catalogue every time. What is kept says nothing about anything outside the
+    catalogue it was made for, so a bounded cache of them is the width of the memory.
+    """
+    _version, _sum, elements = catalogue.written_as(classname) or (0, None, ())
+    return _Row(_row_pack(elements), tuple(element[1] for element in elements))
+
+
+def _row_pack(elements: tuple[Element, ...]) -> struct.Struct | None:
+    """The ``struct`` that writes every member of a record of numbers, or ``None`` where one of
+    them is something else - an object, a container, a string, a packed float, an array."""
+    plain = all(
+        element[0] == "TStreamerBasicType" and not element[5] and not element[6]
+        for element in elements
+    )
+    return pack_row([element[3] for element in elements]) if plain else None
+
+
 #: How each kind of element is written.
 _ELEMENTS: dict[str, Callable[[_Writer, Element, Any, Mapping[str, Any]], None]] = {
     "TStreamerBase": _Writer._base,
