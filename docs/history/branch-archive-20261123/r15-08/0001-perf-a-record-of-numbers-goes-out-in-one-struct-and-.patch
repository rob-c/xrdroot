+    from xrdroot import wdobjects
+
+    _cls, catalogue, obj = _numbers_for()
+    one_call = _record(catalogue, obj)
+    monkeypatch.setattr(wdobjects, "_row_as", lambda seen, name: wdobjects._Row(None, ()))
+    assert _record(catalogue, obj) == one_call
+
