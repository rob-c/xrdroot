+def pack_row(stypes: Sequence[int]) -> struct.Struct | None:
+    """One ``struct`` for a record whose members are every one of them a plain number, or
+    ``None`` where one is not: a packed float, a member of a width ``struct`` has no code for.
+
+    A class of numbers is written as nine members each of which costs a ``struct`` call, a
+    ``bytes`` object and an append - roottest's own benchmark writes ten million of them -
+    where one ``pack`` of all nine is the same bytes in one call. The codes are exactly those
+    :func:`pack_one` uses, so a record written this way is the record written member by member.
+    """
+    codes = []
+    for stype in stypes:
+        if stype not in BASIC or stype in (DOUBLE32, FLOAT16):
+            return None
+        codes.append(_packer(stype).format.lstrip("<>"))
+    return struct.Struct(">" + "".join(codes))
+
