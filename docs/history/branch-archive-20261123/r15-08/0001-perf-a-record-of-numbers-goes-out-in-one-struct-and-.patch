+def test_a_row_of_plain_numbers_is_one_struct_of_every_member_s_width() -> None:
+    """Nine members of numbers - what roottest's own bulk ``Streamer`` loop writes ten million
+    times - are one ``pack`` of all nine, so the struct is the width of each member in turn."""
+    row = pack_row([3, 3, 5, 3, 5, 3, 5, 3, 5])
+    assert row is not None and row.format == ">iifififif"
+    stypes = [3, 3, 5, 3, 5, 3, 5, 3, 5]
+    values = [1, 2, 0.5, 3, 0.25, 4, 0.125, 5, 0.0625]
+    assert row.pack(*values) == b"".join(
+        pack_one(stype, "", value) for stype, value in zip(stypes, values, strict=True)
