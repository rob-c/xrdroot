+#: A class of nothing but numbers, which is what roottest's own bulk ``Streamer`` benchmark
+#: writes ten million times: every member of its record is written by the same one ``struct``.
+NUMBERS = r"""
+class Numbers {
+public:
+   int a1;
+   float a2;
+   int a3;
+   Numbers() : a1(0), a2(0), a3(0) {}
+};
+"""
+
+
+def _numbers_for() -> tuple[type, Catalogue, Any]:
+    """``the numbers`` class declared, its catalogue, and an object of it holding 7, 1.5, -3."""
+    run_source(NUMBERS, "numbers.C", call=False)
+    cls = find_class("Numbers")
+    catalogue = catalogue_of(cls)
+    obj = cls()
+    obj.a1, obj.a2, obj.a3 = 7, 1.5, -3
+    return cls, catalogue, obj
+
+
+def _record(catalogue: Catalogue, obj: Any) -> bytes:
+    buf = WBuffer()
+    write_value(buf, "Numbers", plain_value(obj, "Numbers", catalogue), catalogue)
+    return bytes(buf.data)
+
+
+def test_a_record_of_numbers_is_one_struct_and_is_the_bytes_of_its_members():
+    """Nine members of numbers in a bulk loop cost nine ``struct`` calls, a ``bytes`` and an
+    append each; one ``pack`` of all of them is the same bytes in one call."""
+    _cls, catalogue, obj = _numbers_for()
+    written = _record(catalogue, obj)
+    # The count and, a class without ``ClassDef`` carrying its checksum where a version goes,
+    # the zero and the checksum; then the three numbers, in the width each is declared with.
+    assert written[:6] == bytes.fromhex("40000012" "0000")
+    assert written[10:] == bytes.fromhex("00000007" "3fc00000" "fffffffd")
+
+
