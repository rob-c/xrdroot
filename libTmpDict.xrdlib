 "python": "# Translated from libTmpDict by xrdroot.pycint. Undeclared names are ROOT.<name>; the C++\n# semantics Python lacks (integer division, printf, cells for &x) are the runtime's.\nfrom xrdroot.pycint.runtime import *  # noqa: F403\n\n\nclass Part:\n    _cxx_layout_ = ('Part', (), (('fX', 'double', '', ()), ('fN', 'int', '', ())))\n    _cxx_destroyed = False\n    _cxx_released = False\n\n    def __init__(self, fX=None, fN=None):\n        self.fX = 0.0 if fX is None else fX\n        self.fN = 0 if fN is None else fN\n\n\nclass Whole:\n    _cxx_layout_ = ('Whole', (), (('fPart', 'Part', '', ()), ('fY', 'double', '', ())))\n    _cxx_destroyed = False\n    _cxx_released = False\n\n    def __init__(self, fPart=None, fY=None):\n        self.fPart = Part() if fPart is None else fPart\n        self.fY = 0.0 if fY is None else fY\n\n\ndef w(name):\n    f = ROOT.TFile(name, 'RECREATE')\n    try:\n        t = ROOT.TTree('t', 'whole')\n        one = Whole()\n        t.Branch('w', one)\n        for i in range(0, 3):\n            one.fY = i * 1.5\n            one.fPart.fX = float(i)\n            one.fPart.fN = i + 1\n            t.Fill()\n        t.Write()\n        f.Close()\n    finally:\n        f._destruct()\n",
