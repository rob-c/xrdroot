 self.fNtrack = 0\n        self.fNseg = 0\n        self.fNvertex = 0\n        self.fMeasures = array('int', Event.kSize)\n        self.fFlag = 0\n        self.fMatrix = array('float', (4, 4))\n        self.fClosestDistance = None\n        self.fTemperature = 0.0\n        self.fTracksInVertex = None\n        self.fVectorLong64 = ROOT.std.vector['long long']()\n        self.fVectorint2 = ROOT.std.vector['int']()\n        self.fVectorint = ROOT.std.vector['int']()\n        self.fVectorshort = ROOT.std.vector['short']()\n        self.fVectorD = array('std::vector<double>', 4, make=ROOT.std.vector['double'])\n        self.fVectorTLine = ROOT.std.vector['TLine']()\n        self.fVectorTobject = None\n        self.fVectorTnamed = array('std::vector<TNamed>*', 6)\n        self.fLachaud = ROOT.std.vector['std::string']()\n        self.fDeque = ROOT.std.deque['TAttLine']()\n        self.fVectorTobjectp = ROOT.std.list['TObject*']()\n        self.fListString = None\n        self.fListStringp = ROOT.std.list['std::string*']()\n        self.fMapTNamedp = ROOT.std.map['TNamed*', 'int']()\n        self.fTemplateMember = template2__template1_int()\n        self.fMapList = ROOT.std.map['TString', 'TList*']()\n        self.fMapTString = ROOT.std.map['TString', 'TString*']()\n        self.fMapHeaderP = ROOT.std.map['EventHeader', 'TString*']()\n        self.fMapHeader = ROOT.std.map['EventHeader', 'TString']()\n        self.fMapHeaderst = ROOT.std.map['EventHeader', 'std::string']()\n        self.fMapTAxisp = None\n        self.fSetTAxis = ROOT.std.set['TAxis*']()\n        self.fSetTAxisp = None\n        self.fMultiMapTNamedp = ROOT.std.multimap['TNamed*', 'int']()\n        self.fMultiSetTAxisp = None\n        self.fVectAxis = ROOT.std.vector['std::vector<TAxis*>']()\n        self.fMapString = ROOT.std.map['std::string', 'std::vector<int>']()\n        self.fDequePair = ROOT.std.deque['std::pair<float,float>']()\n        self.fString = ''\n        self.fStringp = None\n        self.fTs