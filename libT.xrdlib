 y < 4 else 0)\n\n    def GetUshort(self):\n        return self.fUshort\n\n    @staticmethod\n    def Class_Version():\n        return 1\n\n    @staticmethod\n    def Class():\n        return ROOT.TClass.GetClass('Event')\n\n    @staticmethod\n    def Class_Name():\n        return 'Event'\n\n    def IsA(self):\n        return ROOT.TClass.GetClass('Event')\n\n    def Streamer(self, b):\n        ROOT.TClass.GetClass('Event').Streamer(self, b)\n\n\nclass Track(ROOT.TObject):\n    _cxx_layout_ = ('Track', ('TObject',), (('fPx', 'Float_t', 'X component of the momentum', ()), ('fPy', 'Float_t', 'Y component of the momentum', ()), ('fPz', 'Float_t', 'Z component of the momentum', ()), ('fRandom', 'Float_t', 'A random track quantity', ()), ('fMass2', 'Float_t', 'The mass square of this particle', ()), ('fBx', 'Float_t', 'X intercept at the vertex', ()), ('fBy', 'Float_t', 'Y intercept at the vertex', ()), ('fMeanCharge', 'Float_t', 'Mean charge deposition of all hits of this track', ()), ('fXfirst', 'Float_t', 'X coordinate of the first point', ()), ('fXlast', 'Float_t', 'X coordinate of the last point', ()), ('fYfirst', 'Float_t', 'Y coordinate of the first point', ()), ('fYlast', 'Float_t', 'Y coordinate of the last point', ()), ('fZfirst', 'Float_t', 'Z coordinate of the first point', ()), ('fZlast', 'Float_t', 'Z coordinate of the last point', ()), ('fHits', 'std::vector<int>', 'list of hits', ()), ('fCharge', 'Float_t', 'Charge of this track', ()), ('fVertex', 'Float_t', 'Track vertex position', (3,)), ('fCovar', 'Float_t', 'Covariance matrix', (3, 4)), ('fCovara', 'Float_t', 'Covariance matrix', (3, 4, 2)), ('fNpoint', 'Int_t', 'Number of points for this track', ()), ('fValid', 'Short_t', 'Validity criterion', ()), ('fPoints', 'Short_t*', '[fNpoint] List of points', ()), ('fTrackName', 'char*', 'Track name', ()), ('fInts', 'TArrayI', 'some integers', ())))\n    _cxx_destroyed = False\n    _cxx_released = False\n\n    def __init__(self):\n        ROOT.TObject.__init__(