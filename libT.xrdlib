ay', (4, 4)), ('fClosestDistance', 'Float_t*', '[fNvertex] pointer to an array of floats of length fNvertex', ()), ('fTemperature', 'Float_t', 'event temperature', ()), ('fTracksInVertex', 'char*', '[fNvertex]', ()), ('fVectorLong64', 'std::vector<Long64_t>', 'STL vector on ints', ()), ('fVectorint2', 'std::vector<Int_t>', '', ()), ('fVectorint', 'std::vector<int>', 'STL vector on ints', ()), ('fVectorshort', 'std::vector<short>', 'STL vector of shorts', ()), ('fVectorD', 'std::vector<double>', 'array of STL vectors of doubles', (4,)), ('fVectorTLine', 'std::vector<TLine>', '|| array of STL vectors of TLine objects', ()), ('fVectorTobject', 'std::vector<TObject>*', '|| pointer to an STL vector', ()), ('fVectorTnamed', 'std::vector<TNamed>*', '|| array of pointers to STL vectors', (6,)), ('fLachaud', 'std::vector<std::string>', 'an STL vector of strings', ()), ('fDeque', 'std::deque<TAttLine>', 'STL deque', ()), ('fVectorTobjectp', 'std::list<TObject*>', 'STL list of pointers to objects', ()), ('fListString', 'std::list<std::string>*', 'STL list of strings', ()), ('fListStringp', 'std::list<std::string*>', 'STL list of pointers to strings', ()), ('fMapTNamedp', 'std::map<TNamed*, int>', 'STL map', ()), ('fTemplateMember', 'template2<template1<int>>', '', ()), ('fMapList', 'std::map<TString, TList*>', 'STL map', ()), ('fMapTString', 'std::map<TString, TString*>', '/<!STL map', ()), ('fMapHeaderP', 'std::map<EventHeader, TString*>', '/<!STL map', ()), ('fMapHeader', 'std::map<EventHeader, TString>', '/<!STL map', ()), ('fMapHeaderst', 'std::map<EventHeader, std::string>', '/<!STL map', ()), ('fMapTAxisp', 'std::map<TAxis*, int>*', 'pointer to STL map', ()), ('fSetTAxis', 'std::set<TAxis*>', 'STL set', ()), ('fSetTAxisp', 'std::set<TAxis*>*', 'pointer to STL set', ()), ('fMultiMapTNamedp', 'std::multimap<TNamed*, int>', 'STL multimap', ()), ('fMultiSetTAxisp', 'std::multiset<TAxis*>*', 'pointer to STL multiset', ()), ('fVectAxis', 'std::vector<std::vector<TAxis*>>', '/<