32(self.fCovara[i][j][k])\n\n    def GetNpoint(self):\n        return self.fNpoint\n\n    def GetValid(self):\n        return self.fValid\n\n    def SetValid(self, valid=1):\n        self.fValid = i16(valid)\n\n    @staticmethod\n    def Class_Version():\n        return 1\n\n    @staticmethod\n    def Class():\n        return ROOT.TClass.GetClass('Track')\n\n    @staticmethod\n    def Class_Name():\n        return 'Track'\n\n    def IsA(self):\n        return ROOT.TClass.GetClass('Track')\n\n    def Streamer(self, b):\n        ROOT.TClass.GetClass('Track').Streamer(self, b)\n\n\nclass BigTrack(Track):\n    _cxx_layout_ = ('BigTrack', ('Track',), (('fSpecial', 'Int_t', 'The BigTrack validity flag', ()), ('fKine', 'TLorentzVector', 'more kinematics', ())))\n    _cxx_destroyed = False\n    _cxx_released = False\n\n    def __init__(self):\n        Track.__init__(self)\n        self.fSpecial = 0\n        self.fKine = ROOT.TLorentzVector()\n        self.fSpecial = 1234\n\n    def _destruct(self):\n        if self._cxx_destroyed:\n            return\n        self._cxx_destroyed = True\n\n    @staticmethod\n    def Class_Version():\n        return 1\n\n    @staticmethod\n    def Class():\n        return ROOT.TClass.GetClass('BigTrack')\n\n    @staticmethod\n    def Class_Name():\n        return 'BigTrack'\n\n    def IsA(self):\n        return ROOT.TClass.GetClass('BigTrack')\n\n    def Streamer(self, b):\n        ROOT.TClass.GetClass('BigTrack').Streamer(self, b)\n\n    def __del__(self):\n        if self._cxx_released:\n            return\n        self._destruct()\n\n\nclass HistogramManager:\n    _cxx_layout_ = ('HistogramManager', (), (('fNtrack', 'TH1F*', '', ()), ('fNseg', 'TH1F*', '', ()), ('fTemperature', 'TH1F*', '', ()), ('fPx', 'TH1F*', '', ()), ('fPy', 'TH1F*', '', ()), ('fPz', 'TH1F*', '', ()), ('fRandom', 'TH1F*', '', ()), ('fMass2', 'TH1F*', '', ()), ('fBx', 'TH1F*', '', ()), ('fBy', 'TH1F*', '', ()), ('fMeanCharge', 'TH1F*', '', ()), ('fXfirst', 'TH1F*', '', 