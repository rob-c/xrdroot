+        """The characters: this string's, or the object's it is a view of."""
+        view = self.__dict__.get("_view")
+        return self.__dict__.get("_own", "") if view is None else str(view[0]())
+
+    @_s.setter
+    def _s(self, text: str) -> None:
+        view = self.__dict__.get("_view")
+        if view is None:
+            self.__dict__["_own"] = text
+        else:
+            view[1](text)
+
     # -- as Python's string ------------------------------------------------------
 
     def __str__(self) -> str:
