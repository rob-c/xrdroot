+    def __init__(self, text: Any = "", length: Any = None, view: Any = None) -> None:
+        if view is not None:
+            #: A ``TString`` member of an object - ``TNamed::fName`` - is not this string's
+            #: own: ``Form`` and the rest write back through ``view``, which is how a macro
+            #: naming an object by its ``fName`` renames the object.
+            self._view = view
+            return
         held = "" if text is None else _text(text)
         self._s = held[: int(length)] if length is not None else held
 
+    @property
