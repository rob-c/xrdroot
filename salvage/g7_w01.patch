+def member_string(obj: Any, member: str) -> TString:
+    """``obj``'s ``member`` as a ``TString`` that changes the object where it stands.
+
+    ROOT keeps a ``TNamed``'s name and title in the ``TString`` members ``fName`` and
+    ``fTitle``; the getter and setter are looked up on the object each time so that a class
+    of the macro's that writes its name its own way - a histogram's, which carries its axes'
+    titles too - is asked, rather than this class's.
+    """
+    return TString(view=(lambda: getattr(obj, "Get" + member[1:])(),
+                       lambda text: getattr(obj, "Set" + member[1:])(text)))  # fmt: skip
+
+
