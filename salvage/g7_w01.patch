--- a/tests/test_pyroot_objects.py
+++ b/tests/test_pyroot_objects.py
@@ -205,6 +205,36 @@ def test_attributes_are_kept_on_an_object_without_members_of_its_own():
     assert thing.GetLineColor() == 1
 
 
+def test_a_named_object_is_renamed_by_writing_the_tstring_member_its_name_is():
+    """``fName`` and ``fTitle`` are the ``TString`` members a derived C++ class writes - ROOT's
+    ``TNamed`` keeps its name there - so ``fName.Form(...)`` renames the object it belongs to,
+    and a ``TString`` read off one is the object's text rather than a copy of it."""
+    thing = ROOT.TNamed("a", "first")
+    thing.fName.Form("%s_%d", "b", 3)
+    expect(
+        (thing.GetName(), "b_3"),
+        (thing.fName.Data(), "b_3"),
+        (thing.fName.Length(), 3),
+    )
+    thing.fTitle.Form("second %d", 2)
+    assert thing.GetTitle() == "second 2"
+    thing.fName = ROOT.TString("c")  # ``operator=`` of the member, as PyROOT takes it
+    assert thing.GetName() == "c"
+    thing.fName += "d"  # in place, through the same member
+    assert thing.GetName() == "cd"
+
+
+def test_a_histogram_renamed_through_fname_is_renamed_by_its_own_set_name():
+    """A histogram's name is its ``TNamed`` member as a plain object's is, but writing it goes
+    through ``TH1::SetName``, which a class that keeps more than the name needs."""
+    h = ROOT.TH1F("h", "", 1, 0, 1)
+    h.fName.Form("%s%d", "hh", 2)
+    expect(
+        (h.GetName(), "hh2"),
+        (h._xrd._core["TNamed"]["fName"], "hh2"),
+    )
+
+
