+def test_loading_a_dictionary_declares_its_enumerations_to_the_interpreter() -> None:
+    """A dictionary's enumerations are the interpreter's as soon as the library is loaded, and
+    the title of one is the name of the namespace declaring it - which the 6.40.04 oracle
+    answers for roottest's ``qualifiedNames`` (``enpclass/myns``) - and none where a class or
+    the global namespace declares it, whose own name is not a scope."""
+    enums_library()
+    assert troot.find_enum("myns::enpclass") is None
+    assert load("libEnums") == 0
+    namespaced = troot.find_enum("myns::enpclass")
+    assert namespaced is not None and namespaced.GetTitle() == "myns"
+    global_enum = troot.find_enum("enpclass")
+    assert global_enum is not None and global_enum.GetTitle() == ""
+    mode = troot.find_enum("Holder::Mode")
+    assert mode is not None and (mode.GetTitle(), mode.IsScoped()) == ("", True)
+    assert mode.GetUnderlyingType() == 2  # kShort_t, as the oracle answers for ``: short``
+    assert [one.GetName() for one in troot.class_enums("Holder")] == ["Mode"]
+
+
+def test_an_enumeration_a_dictionary_declares_is_autoloaded_by_its_name() -> None:
+    """``TEnum::GetEnum`` reads the library its rootmap says declares the enumeration, so a
+    program asking for one no header has read yet finds it - roottest's ``qualifiedNames``
+    never loads its dictionary itself, and ``kNone`` says not to."""
+    enums_library()
+    assert troot.TEnum.GetEnum("myns::enpclass", troot.TEnum.kNone) is None
+    assert ours() == []
+    found = troot.TEnum.GetEnum("myns::enpclass")
+    assert found is not None and found.GetQualifiedName() == "myns::enpclass"
+    assert ours() == ["libEnums"]
+    assert troot.TEnum.GetEnum("enpclass") is not None  # the one of the global namespace
+    assert troot.TEnum.GetEnum("Nowhere::ENone") is None
+
+
+def test_a_rootmap_that_lists_an_enumeration_provides_it_by_its_name() -> None:
+    """``provides`` is what a rootmap entry means: the library declaring the name - a class by
+    any of its qualified spellings, a namespace, a function, an enumeration."""
+    library = read(enums_library())
