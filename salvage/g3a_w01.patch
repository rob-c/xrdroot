+#: A header whose enumerations a program asks ROOT's interpreter for by name - the shape
+#: roottest's ``qualifiedNames`` and ``enumsTestClasses`` dictionaries have.
+ENUMS_H = """\
+#ifndef ENUMS_H
+#define ENUMS_H
+namespace myns { enum enpclass {kNoneNonConflicting}; }
+enum enpclass {kNoneNonConflicting};
+class Holder { public: enum class Mode : short {kOff, kOn}; };
+#endif
+"""
+
+
+def enums_library() -> Path:
+    """``libEnums.xrdlib``: a dictionary of :data:`ENUMS_H`, and nothing else in it."""
+    write("Enums.h", ENUMS_H)
+    return build_dictionary("Enums", [Path("Enums.h")], out=None)
+
+
+def noted(source: str) -> list[translate.EnumNote]:
+    """What the interpreter notes of the enumerations ``source`` declares, as it parses it."""
+    from xrdroot.pycint.dialect import ROOT as CINT
+    from xrdroot.pycxx.dialect import using
+    from xrdroot.pycxx.parse_decl import parse
+    from xrdroot.pycxx.preprocessor import preprocess
+
+    with using(CINT):
+        tokens, _ = preprocess(source, "<enums>", [])
+        return translate.enums_of(parse(tokens))
+
+
+def test_the_enumerations_a_unit_declares_are_read_off_its_declarations() -> None:
+    """Each is kept by the name C++ writes it by, with its constants' values counted on as C++
+    counts them and the type it is stored as; one with no name of its own - ``enum {kA};`` -
+    is one nothing looks up, so it is not kept, and one met again - a header read twice - is
+    the enumeration already kept, as ROOT's table holds one ``TEnum`` per enumeration."""
+    found = noted(
+        "enum EFirst {kA, kB = 5, kC};\n"
+        "namespace n { namespace inner { enum EIn {kOne}; } }\n"
+        "class C { public: enum class Mode : short {kOff}; };\n"
+        "enum EFirst {kA};\n"
+        "enum {kAnonymous};\n"
+        "namespace n { enum EIn2 {}; }\n"
+    )
+    assert [(note.qualified, note.items) for note in found] == [
+        ("EFirst", (("kA", 0), ("kB", 5), ("kC", 6))),
+        ("n::inner::EIn", (("kOne", 0),)),
+        ("C::Mode", (("kOff", 0),)),
+        ("n::EIn2", ()),
+    ]
+    assert found[2].scoped is True and found[2].underlying == "short"
+    assert translate.EnumNote.of_stored(found[1].as_stored()) == found[1]
+
+
+def test_an_enumerators_value_is_what_cpp_works_out_and_anything_else_ends_the_list() -> None:
+    """ROOT's table holds every constant of an enumeration, so one whose values this cannot
+    work out - a call, a float, a cast, a name no enumeration declares - is left out of the
+    table rather than noted with a value that is not its own."""
+    found = noted(
+        "enum G {kG = 3};\n"
+        "enum EArithmetic {kA = 1 << 4, kB, kC = -2, kD = 7 / 2, kE = -7 / 2, kF = kA | kB};\n"
+        "enum ERef {kA = G::kG, kB = kA + 1, kC = true, kD = 'a'};\n"
+        "enum EUnary {kA = ~0, kB = +81, kC = !5};\n"
+        "enum EFloat {kA = 3.7, kB};\n"
+        "enum ECast {kA = (int) 1, kB};\n"
+        "enum EName {kA = someConst, kB};\n"
+        "enum EPartial {kA = 2, kB = one(), kC};\n"
+        "enum EDivZero {kA = 1 / 0, kB};\n"
+        "enum EOperation {kA = 1 && 2, kB};\n"
+    )
+    assert [(note.qualified, note.items) for note in found] == [
+        ("G", (("kG", 3),)),
+        ("EArithmetic", (("kA", 16), ("kB", 17), ("kC", -2), ("kD", 3), ("kE", -3), ("kF", 17))),
+        ("ERef", (("kA", 3), ("kB", 4), ("kC", 1), ("kD", 97))),
+        ("EUnary", (("kA", -1), ("kB", 81), ("kC", 0))),
+        ("EPartial", (("kA", 2),)),
+    ]
+
