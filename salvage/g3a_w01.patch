+def test_a_translation_notes_its_enumerations_even_when_it_is_read_from_the_cache() -> None:
+    """A cached translation is not parsed again, so what its parse noted is kept with it: a
+    line declaring an enumeration twice tells the interpreter of it both times."""
+    from xrdroot.pycint.dialect import ROOT as CINT
