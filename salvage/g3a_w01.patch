+@dataclass(frozen=True)
+class EnumNote:
+    """One enumeration a translation declares, as ROOT's interpreter knows it once it has
+    read the declaration: the name C++ writes it by, its enumerators with their values, and
+    the type it is stored as.
+
+    It is what a :class:`~xrdroot.pycxx.translation.Translation` keeps as its notes, so the
+    form it is kept in is plain JSON - a library's manifest holds it, and a cached
+    translation too, which is why a run from the cache notes the same enumerations as the
+    run that translated the program.
+    """
+
+    qualified: str
+    items: tuple[tuple[str, int], ...] = ()
+    #: Whether it is an ``enum class``, whose constants need its name to be written.
+    scoped: bool = False
+    #: The integer type written after ``:``, as C++ spells it - ``short``, ``unsigned char``.
+    underlying: str = ""
+
+    def as_stored(self) -> dict[str, Any]:
+        """The note as plain JSON, which a manifest and a cached translation keep."""
+        return {"qualified": self.qualified, "items": [list(each) for each in self.items],
+                "scoped": self.scoped, "underlying": self.underlying}  # fmt: skip
+
+    @staticmethod
+    def of_stored(stored: dict[str, Any]) -> EnumNote:
+        """The note ``as_stored`` wrote."""
+        return EnumNote(
+            str(stored["qualified"]),
+            tuple((str(name), int(value)) for name, value in stored.get("items", ())),
+            bool(stored.get("scoped", False)),
+            str(stored.get("underlying", "")),
+        )
+
+
+def enums_of(unit: Unit) -> list[EnumNote]:
+    """The enumerations ``unit`` declares, each once by its qualified name, in the order met.
+
+    ROOT's interpreter knows an enumeration as soon as it has read the declaration - the line
+    declaring it need not have run yet - so this is what a translation notes as it is
+    parsed, and what a dictionary build keeps for the session that loads it.
+    """
+    found: list[EnumNote] = []
+    _enums(unit.decls, [], found, {})
+    return found
+
+
+def _enums(decls: list[Stmt], scope: list[str], found: list[EnumNote],
+           known: dict[str, int]) -> None:  # fmt: skip
+    """Every enumeration ``decls`` declare, in ``scope``, noting each with ``known`` - the
+    constants of the enumerations declared before it - and adding its own as it goes."""
+    for decl in decls:
+        if isinstance(decl, Namespace):
+            _enums(decl.body, scope if decl.name is None else [*scope, decl.name], found, known)
+        elif isinstance(decl, EnumDecl):
+            _note_enum(found, scope, decl, known)
+        elif isinstance(decl, ClassDecl) and decl.name:
+            _enums(decl.members, [*scope, decl.name], found, known)
+
+
+def _note_enum(found: list[EnumNote], scope: list[str], decl: EnumDecl,
+               known: dict[str, int]) -> None:  # fmt: skip
+    """Keep the enumeration ``decl``, declared in ``scope``, as the interpreter knows it.
+
+    An enumeration with no name of its own - ``enum {kA};`` - is one nothing looks up and so
+    is not noted, and one already met - a header included again behind no guard - is kept
+    once, as ROOT's table keeps one ``TEnum`` per enumeration. One whose first enumerator is
+    a value only a compiler works out is not noted either: ROOT's table would hold the
+    constants, and an enumeration noted without them is a name a lookup finds but nothing
+    about which is true.
+    """
+    if not decl.name:
+        return
+    qualified = "::".join([*scope, decl.name])
+    if any(note.qualified == qualified for note in found):
+        return
+    items = _valued(decl.items, known)
+    if decl.items and not items:
+        return
+    underlying = decl.underlying.name if decl.underlying is not None else ""
+    found.append(EnumNote(qualified, tuple(items), decl.scoped, underlying))
+    known.update(dict(items))
+    known.update({f"{qualified}::{name}": value for name, value in items})
+
+
+def _valued(declared: list[tuple[str, Expr | None]],
+            known: dict[str, int]) -> list[tuple[str, int]]:  # fmt: skip
+    """Each enumerator and its value, counted on from the last as C++ counts, as far as the
+    declarations say: an enumerator given something this cannot work out ends the list,
+    since a wrong value in the table is worse than a value missing."""
+    values: list[tuple[str, int]] = []
+    last = -1
+    for name, written in declared:
+        counted = last + 1 if written is None else _number(written, known)
+        if counted is None:
+            break
+        known[name] = last = counted
+        values.append((name, counted))
+    return values
+
+
+def _quotient(a: int, b: int) -> int:
+    """C++'s integer division: truncated towards zero, which Python's ``//`` does not."""
+    return abs(a) // abs(b) * (1 if (a < 0) == (b < 0) else -1)
+
+
+#: The arithmetic and bit operations an enumerator's value may be written with, as C++'s
+#: integers do them.
+INTEGER_OPERATIONS: dict[str, Any] = {
+    "+": lambda a, b: a + b,
+    "-": lambda a, b: a - b,
+    "*": lambda a, b: a * b,
+    "/": _quotient,
+    "%": lambda a, b: a - b * _quotient(a, b),
+    "<<": lambda a, b: a << b,
+    ">>": lambda a, b: a >> b,
+    "&": lambda a, b: a & b,
+    "|": lambda a, b: a | b,
+    "^": lambda a, b: a ^ b,
+}
+
+#: The unary operations one may be written with: ``-1``, ``~mask``, and ``!value``, which C++
+#: types as an ``int`` rather than as its operand's type.
+UNARY_OPERATIONS: dict[str, Any] = {
+    "-": lambda value: -value,
+    "+": lambda value: value,
+    "~": lambda value: -value - 1,
+    "!": lambda value: int(not value),
+}
+
+
+def _number(value: Expr, known: dict[str, int]) -> int | None:
+    """An enumerator's value when it is an integer this can work out: a number written out,
+    ``true``, a constant an enumeration declared before this one, or arithmetic and bit
+    operations on those. Anything else - a call, a float, a cast, ``sizeof`` - is ``None``.
+    """
+    if isinstance(value, Literal):
+        return _literal_number(value)
+    if isinstance(value, Unary):
+        return _unary_number(value, known)
+    if isinstance(value, Binary):
+        return _binary_number(value, known)
+    return known.get("::".join(value.parts)) if isinstance(value, Name) else None
+
+
+def _literal_number(value: Literal) -> int | None:
+    """``3``, ``'a'`` or ``true``; ``3.7`` and a string are no integer C++ counts on."""
+    if value.kind == "bool":
+        return int(bool(value.value))
+    return int(value.value) if value.kind in ("int", "char") else None
+
+
+def _unary_number(value: Unary, known: dict[str, int]) -> int | None:
+    """``-kA``, ``+81``, ``~mask``: the operation, when its operand is a number here."""
+    operation = UNARY_OPERATIONS.get(value.op)
+    inner = _number(value.operand, known)
+    return None if operation is None or inner is None else int(operation(inner))
+
+
+def _binary_number(value: Binary, known: dict[str, int]) -> int | None:
+    """``1 << 14``, ``kA | kB``: C++'s integer operation, when both sides are numbers here.
+
+    One C++ itself would refuse - ``1 / 0`` - is no value either, and must not raise.
+    """
+    operation = INTEGER_OPERATIONS.get(value.op)
+    left, right = _number(value.left, known), _number(value.right, known)
+    if operation is None or left is None or right is None:
+        return None
+    try:
+        return int(operation(left, right))
+    except (ArithmeticError, ValueError):
+        return None
+
