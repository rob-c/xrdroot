+def scope_declared(name: Any) -> bool:
+    """Whether the class or namespace ``name`` puts an enumeration in - ``N::E``'s ``N`` - is
+    one this session has, whose own list of enumerations already answers for it.
+
+    A namespace or class is had once a line, a macro or a loaded library declared it, which
+    is what the interpreter keeps its names in; asking ``TClass::GetClass`` is no test, as
+    it takes a class no dictionary describes to be there - and loads one to say so.
+    """
+    owner = str(name).rpartition("::")[0]
+    if not owner:
+        return False
+    from ...pycxx.runtime.namespace import DECLARED
+
+    return owner in DECLARED
+
