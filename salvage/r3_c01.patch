+def _held_classes(typename: str) -> list[str]:
+    """The classes a member's type holds or points at, as ROOT reports them missing: the type
+    itself with the ``const``, the pointers, references and array lengths off it, and then
+    each class its template arguments name - ``vector<Elem>``, then ``Elem``."""
+    text = typename.strip()
+    for mark in ("const", "volatile"):
+        text = text.removeprefix(mark).strip().removesuffix(mark).strip()
+    text = text.rstrip("*& ").split("[")[0].strip()
+    if not text or text in FUNDAMENTAL or text.endswith("*"):
+        return []
+    found = [_known_as(text)]
+    if "<" in text:
+        inner = text[text.index("<") + 1 : text.rindex(">")]
+        found += [each for part in inner.split(",") for each in _held_classes(part)]
+    return found
+
+
+def _dictionaried(name: str) -> bool:
+    """Does the process have a dictionary that describes the class ``name``?
+
+    A class a dictionary describes is one of ROOT's own the kit carries, or one a library or
+    ``GenerateDictionary`` provided. A standard container is not: the kit can make one of
+    any element type, but ROOT has a dictionary of ``vector<Elem>`` only once something
+    generated one, which is why a class holding such a vector reports it missing.
+    """
+    return _known_as(name) in _with_dictionary()
