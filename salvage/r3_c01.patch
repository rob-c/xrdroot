+MISSING = r"""
+#include <vector>
+struct Elem { int i = 5; };
+struct ECont { std::vector<Elem> elems; };
+struct Plain { int a; double b; };
+struct Chain { Chain *next; TObject arg; std::vector<Elem> *elems; };
+"""
+
+
+def test_a_class_reports_the_classes_it_holds_that_no_dictionary_describes():
+    """``GetMissingDictionaries``, as roottest's ``CheckMissingDictionaries`` asks it of
+    ``ECont``: ``Elem``'s dictionary does not make one for the ``vector<Elem>`` the class holds,
+    so the vector is what ROOT reports - a class of plain numbers reports nothing - and once a
+    dictionary is generated for the vector there is nothing left to report."""
+    run_source(MISSING, "missing_dictionaries.C", call=False)
+    container = ROOT.THashTable()
+    ROOT.TClass.GetClass("ECont").GetMissingDictionaries(container)
+    plain = ROOT.THashTable()
+    ROOT.TClass.GetClass("Plain").GetMissingDictionaries(plain)
+    walked = ROOT.THashTable()
+    ROOT.TClass.GetClass("Chain").GetMissingDictionaries(walked, True)
+    # The chain's own class is missing and walked into once - ROOT's ``Chain* next`` - its
+    # ``TObject`` member has a dictionary of its own, and a container's element class is
+    # reported too, as ROOT reports ``vector<A>`` and ``A`` of a missing ``A``.
+    recursive = sorted(held.GetName() for held in walked)
+    assert ROOT.gInterpreter.GenerateDictionary("vector<Elem>") == 0
+    after = ROOT.THashTable()
+    ROOT.TClass.GetClass("ECont").GetMissingDictionaries(after)
+    expect(
+        ([held.GetName() for held in container], ["vector<Elem>"]),
+        (list(plain), []),
+        (recursive, ["Chain", "Elem", "vector<Elem>"]),
+        (list(after), []),
+        (container.FindObject("vector<Elem>").GetName(), "vector<Elem>"),
+    )
