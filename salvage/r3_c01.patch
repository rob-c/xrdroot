+def test_the_state_and_checksum_codes_are_the_numbers_root_gives_them():
+    """``TClass::EState`` and ``TClass::ECheckSum``, as ROOT 6.40 numbers them: a program
+    compares what ``GetState`` answers with ``kForwardDeclared``, ``kEmulated`` and
+    ``kHasTClassInit`` (roottest's ``execState``, ``datamemberload``), and asks
+    ``GetCheckSum`` for the newest algorithm's checksum by ``kLatestCheckSum``."""
+    states = ("kNoInfo", "kForwardDeclared", "kEmulated", "kInterpreted", "kHasTClassInit",
+              "kLoaded", "kNamespaceForMeta")  # fmt: skip
+    checksums = ("kCurrentCheckSum", "kNoEnum", "kReflexNoComment", "kNoRange", "kWithTypeDef",
+                 "kReflex", "kNoRangeCheck", "kNoBaseCheckSum", "kLatestCheckSum")  # fmt: skip
+    th1f = ROOT.TClass.GetClass("TH1F")
+    expect(
+        ([getattr(ROOT.TClass, name) for name in states], [0, 1, 2, 3, 4, 4, 5]),
+        ([getattr(ROOT.TClass, name) for name in checksums], [0, 1, 2, 3, 4, 5, 6, 7, 8]),
+        (th1f.GetCheckSum(ROOT.TClass.kLatestCheckSum), th1f.GetCheckSum()),
+    )
+
+
+def test_the_dictionary_lookup_answers_only_for_a_class_a_dictionary_describes():
+    """``TClass::GetDict`` hands back nothing where no dictionary describes the class, which is
+    what a program tests before it loads the library that would - and what ``GetClass`` cannot
+    answer, since it makes a ``TClass`` for a class a macro declared too (roottest's
+    ``execfwdDeclarations`` and ``ROOT-5709``)."""
+    _declared()
+    expect(
+        (ROOT.TClass.GetDict("TH1F").GetName(), "TH1F"),
+        (ROOT.TClass.GetClass("Named").GetName(), "Named"),
+        (ROOT.TClass.GetDict("Named"), None),
+        (ROOT.TClass.GetDict("TNoSuch"), None),
+        (ROOT.TClass.GetDict(ROOT.TNamed).GetName(), "TNamed"),
+    )  # fmt: skip
+
+
+def test_a_class_says_whether_its_dictionary_streams_it_by_hand():
+    """``HasCustomStreamerMember``, as roottest's ``execProperties`` asks it: ROOT's ``TObject``,
+    ``TTree``, ``TEntryList`` and ``TString`` declare a ``Streamer`` of their own and ``TNamed``
+    does not - ``TH1`` does and ``TH1F``, which declares none of its own, does not - and
+    neither does any class a macro declares here."""
+    _declared()
+    asked = (ROOT.TObject.Class(), ROOT.TNamed.Class(), ROOT.TTree.Class(),
+             ROOT.TClass.GetClass("TString"), ROOT.TEntryList.Class())  # fmt: skip
+    expect(
+        ([each.HasCustomStreamerMember() for each in asked], [True, False, True, True, True]),
+        (ROOT.TClass.GetClass("Named").HasCustomStreamerMember(), False),
+        ([ROOT.TClass.GetClass(name).HasCustomStreamerMember()
+          for name in ("TH1", "TH1F", "TProfile", "TLegend", "TEfficiency")],
+         [True, False, True, False, False]),
+    )
+
+
+def test_the_methods_of_a_class_and_of_its_bases_are_listed_together():
+    """``GetListOfMethods`` is the class's own functions - ROOT 6.40's ``TNamed`` lists
+    ``GetName`` and no ``InheritsFrom`` - and ``GetListOfAllPublicMethods`` adds each base's,
+    which is how a name only ``TObject`` declares is found on a ``TNamed``."""
+    named = ROOT.TClass.GetClass("TNamed")
+    own = {method.GetName() for method in named.GetListOfMethods()}
+    every = {method.GetName() for method in named.GetListOfAllPublicMethods()}
+    assert "GetName" in own and "InheritsFrom" not in own
+    assert {"GetName", "InheritsFrom", "Print", "IsA", "ClassName"} <= every
+
