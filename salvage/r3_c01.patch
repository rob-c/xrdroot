+    def _missing_dictionaries(self, result: Any, visited: set[str], recurse: bool) -> None:
+        """The walk ``GetMissingDictionaries`` makes: each class this one holds, added once,
+        and - with ``recurse`` - what that class holds in turn. A member of the class's own
+        type is met again by the walk and is not walked into twice."""
+        if self._name in visited:
+            return
+        visited.add(self._name)
+        for name in self._held_names(recurse):
+            if not _dictionaried(name):
+                result.Add(TClass(name))
+            if recurse:
+                TClass(name)._missing_dictionaries(result, visited, recurse)
